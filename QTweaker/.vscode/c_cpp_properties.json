{
    "version": 4,
    "configurations": [
        {
            "name": "Audiosurf-Tweaker-Linux",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "defines": [
                "_INTELLISENSE",
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "includePath": [
                "${default}",
                "${workspaceFolder}",
                "${workspaceFolder}/Core",
                "${workspaceFolder}/Backend",
                "${workspaceFolder}/NativeImage",
                "/usr/include/qt6/**",
                "/usr/include/qt6/QtCore",
                "/usr/include/qt6/QtQuick",
                "/usr/include/qt6/QtQml"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17"
        },
        {
            "name": "Audiosurf-Tweaker-Windows",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64",
            "defines": [
                "_INTELLISENSE",
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "BUILD_STATIC"
            ],
            "includePath": [
                "${default}",
                "${workspaceFolder}",
                "${workspaceFolder}/Core",
                "${workspaceFolder}/Backend",
                "${workspaceFolder}/NativeImage",
                "${env:QTDIR}/include/**",
                "${env:VCPKG_ROOT}/installed/x64-windows-static/include"
            ]
        }
    ]
}