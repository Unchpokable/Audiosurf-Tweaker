{
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.fontFamily": "Anonymous Pro",
    "editor.fontWeight": "600",
    "editor.fontSize": 16,
    "terminal.integrated.fontFamily": "NotoMono Nerd Font Mono",
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "enumMember": "#B5CEA8",
            "namespace": "#90cfc3",
            "parameter": "#8DB4D3",
            "property": "#D7A0D1",
            "operatorOverload": "#4EC9B0"
        }
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "variable.other.enummmember.cpp",
                "settings": {
                    "foreground": "#B5CEA8",
                    "fontStyle": "bold"
                }
            }
        ]
    },
    "files.associations": {
