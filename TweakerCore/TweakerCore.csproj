<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Pinned to match the SkiaSharp version Avalonia 12.0.5 (the phase-4 UI target) resolves to
         transitively, so the native binary doesn't get pulled twice at conflicting versions. -->
    <PackageReference Include="SkiaSharp" Version="4.150.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TweakerCore.Tests" />
  </ItemGroup>

  <!-- Sky projects (Skyboxes/SkyTemplates, SkyEditorSupport). The templates are TweakerCore's own; the shader headers
       are the plugin's, taken straight from its sources so the copy an editor sees is the one built into the DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="Skyboxes\Templates\**\*" LogicalName="SkyTemplates/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\TweakerPlugin\assets\shaders\*.hlsli" LogicalName="SkyHeaders/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
