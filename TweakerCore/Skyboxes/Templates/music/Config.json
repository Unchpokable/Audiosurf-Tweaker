// A sky package's manifest. The whole format: https://github.com/Unchpokable/Audiosurf-Tweaker/blob/HEAD/Docs/skyboxes/manifest.md
// Comments and trailing commas are allowed. Install from Tweaker's Skyboxes tab - or switch on "Install on save" -
// and the running game rebuilds the sky from what you saved.
{
  "format": 1,

  // The name is also the file this sky is installed as ("<name>.sky") and the key the player's settings are
  // saved under - renaming makes it a new sky.
  "name": "Sky",
  "author": "",

  // Not a release number: bump it only when you change what an existing knob means. It is part of the key the
  // player's settings are saved under, so bumping it resets everything they tuned.
  "version": 1,

  "shared": {
    "lights": [
      {
        "id": "sun",
        "bearing":   { "label": "Sun bearing (deg)",   "default": 30.0, "min": -180, "max": 180 },
        "elevation": { "label": "Sun elevation (deg)", "default": 8.0,  "min": -20,  "max": 85 },
        "color":     { "label": "Sun colour",          "default": [1.0, 0.62, 0.38] },
        "intensity": { "label": "Sun strength",        "default": 1.0,  "min": 0,    "max": 3 }
      }
    ]
  },

  "layers": [
    {
      "id": "sky",
      "kind": "fullsky",
      "shader": "shaders/sky.hlsl",

      "bind": {
        "g_light.xyz": "lights.sun.direction",
        "g_light_color.xyz": "lights.sun.radiance"
      },

      // The music registers (g_music, g_music_slow) are written by the engine every frame - they are not knobs and
      // must not appear here. What the player tunes is how the sky responds to them.
      "params": [
        {
          "group": "Colours",
          "params": [
            { "var": "g_zenith",  "label": "Zenith",  "default": [0.05, 0.08, 0.20] },
            { "var": "g_horizon", "label": "Horizon", "default": [0.55, 0.32, 0.38] },
            { "var": "g_ground",  "label": "Ground",  "default": [0.06, 0.05, 0.08] }
          ]
        },
        {
          "group": "Sun",
          "params": [
            { "var": "g_sun.x", "label": "Disc radius (deg)", "default": 2.0,  "min": 0.1, "max": 8 },
            { "var": "g_sun.y", "label": "Glow tightness",    "default": 24.0, "min": 2,   "max": 1000 },
            { "var": "g_sun.z", "label": "Glow strength",     "default": 0.5,  "min": 0,   "max": 2 }
          ]
        },
        {
          "group": "Music",
          "params": [
            // How loud a song gets is not something the sky can know in advance - so this is the player's to tune.
            { "var": "g_pulse.x", "label": "Response",           "default": 1.2, "min": 0, "max": 4 },
            // 0 follows the beat, 1 follows the phrase (Docs/skyboxes/music.md, "Which number to drive things from").
            { "var": "g_pulse.y", "label": "Follow the phrase",  "default": 0.6, "min": 0, "max": 1 },
            { "var": "g_pulse.z", "label": "Band height (deg)",  "default": 9.0, "min": 1, "max": 45 },
            { "var": "g_pulse_color", "label": "Glow colour",    "default": [1.0, 0.45, 0.70] }
          ]
        }
      ]
    }
  ]
}
