// A sky package's manifest. The whole format: https://github.com/Unchpokable/Audiosurf-Tweaker/blob/HEAD/Docs/skyboxes/manifest.md
// Clouds and the geometry layer: https://github.com/Unchpokable/Audiosurf-Tweaker/blob/HEAD/Docs/skyboxes/clouds.md
// Comments and trailing commas are allowed. Install from Tweaker's Skyboxes tab - or switch on "Install on save" -
// and the running game rebuilds the sky from what you saved.
{
  "format": 1,

  // The name is also the file this sky is installed as ("<name>.sky") and the key the player's settings are
  // saved under - renaming makes it a new sky.
  "name": "Sky",
  "author": "",

  // Not a release number: bump it only when you change what an existing knob means. It is part of the key the
  // player's settings are saved under, so bumping it resets everything they tuned.
  "version": 1,

  // One sun lights the sky and the clouds alike: both layers bind to it, so they cannot disagree about where it is.
  "shared": {
    "lights": [
      {
        "id": "sun",
        "bearing":   { "label": "Sun bearing (deg)",   "default": 30.0, "min": -180, "max": 180 },
        "elevation": { "label": "Sun elevation (deg)", "default": 18.0, "min": -20,  "max": 85 },
        "color":     { "label": "Sun colour",          "default": [1.0, 0.92, 0.80] },
        "intensity": { "label": "Sun strength",        "default": 1.0,  "min": 0,    "max": 3 }
      }
    ]
  },

  "layers": [
    // Drawn first: the sky behind everything.
    {
      "id": "sky",
      "kind": "fullsky",
      "shader": "shaders/sky.hlsl",
      "bind": {
        "g_light.xyz": "lights.sun.direction",
        "g_light_color.xyz": "lights.sun.radiance"
      },
      "params": [
        {
          "group": "Colours",
          "params": [
            { "var": "g_zenith",  "label": "Zenith",  "default": [0.16, 0.36, 0.70] },
            { "var": "g_horizon", "label": "Horizon", "default": [0.80, 0.84, 0.86] },
            { "var": "g_ground",  "label": "Ground",  "default": [0.10, 0.11, 0.13] }
          ]
        },
        {
          "group": "Sun",
          "params": [
            { "var": "g_sun.x", "label": "Disc radius (deg)", "default": 1.2,  "min": 0.1, "max": 8 },
            { "var": "g_sun.y", "label": "Glow tightness",    "default": 64.0, "min": 2,   "max": 1000 },
            { "var": "g_sun.z", "label": "Glow strength",     "default": 0.6,  "min": 0,   "max": 2 }
          ]
        }
      ]
    },

    // Then the clouds: quads on the sky sphere. No "shader" - the pair built into the plugin draws them, and no
    // "fill" - the plugin's own cloud bake paints them. Where they go is yours: scripts/clouds.lua.
    {
      "id": "clouds",
      "kind": "sprites",
      "generator": "scripts/clouds.lua",

      // Fixed, so "did my edit change anything?" has an answer. "random" gives a new sky every load.
      "seed": 1234,

      // The built-in sprite shader reads two lights: g_light (with the ambient floor in .w) and g_light2 (with its
      // weight in .w). Both point at the sun here; g_light2.w is left at 0, so the second adds nothing.
      "bind": {
        "g_light.xyz": "lights.sun.direction",
        "g_light2.xyz": "lights.sun.direction"
      },

      "params": [
        {
          "group": "Cloud cover",
          "params": [
            // "prop" rather than "var": these decide what is in the layer, not how it is shaded. scripts/clouds.lua
            // reads them with tw.prop(), and moving one rebuilds the layer.
            { "prop": "count",   "label": "Clouds",        "default": 160, "min": 0,   "max": 600 },
            { "prop": "size",    "label": "Size (deg)",    "default": 5.0, "min": 0.5, "max": 20 },
            { "prop": "floor",   "label": "Lowest (deg)",  "default": 3.0, "min": -10, "max": 60 },
            { "prop": "ceiling", "label": "Highest (deg)", "default": 45.0, "min": 5,  "max": 90 }
          ]
        },
        {
          "group": "Cloud look",
          "params": [
            { "var": "g_tint",       "label": "Colour",          "default": [1.0, 1.0, 1.0] },
            { "var": "g_tint.w",     "label": "Opacity",         "default": 0.85, "min": 0,   "max": 1 },
            { "var": "g_light.w",    "label": "Ambient light",   "default": 0.35, "min": 0,   "max": 1 },
            { "var": "g_material.x", "label": "Bumpiness",       "default": 0.6,  "min": 0,   "max": 1 },
            { "var": "g_material.y", "label": "Edge softness",   "default": 1.5,  "min": 0.1, "max": 6 },
            { "var": "g_material.z", "label": "Sun through",     "default": 0.6,  "min": 0,   "max": 3 },
            { "var": "g_material.w", "label": "Sun-through spread", "default": 8.0, "min": 1, "max": 64 }
          ]
        }
      ]
    }
  ]
}
