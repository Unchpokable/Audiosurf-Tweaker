# Text files compiled into the DLL as `std::string_view` constants - script mode, run by a custom command:
#
#   cmake -DOUTPUT=<header> -DNAMESPACE=<ns> -DINPUTS=<a.lua|b.lua|...> -P EmbedText.cmake
#
# Each input becomes `<stem>` (a std::string_view) over `<stem>_bytes` (a char array) in NAMESPACE, so
# prelude/callbacks.lua is `<ns>::callbacks`. Inputs are '|'-separated: a ';' list would be split into
# separate arguments on the way through add_custom_command.
#
# Why a char array of '\xHH' literals and not one raw string literal (what lua_prelude.cxx used to be):
# the text can contain any delimiter a raw literal could pick, MSVC caps the length of a single string
# literal, and a character literal is already a `char` - no narrowing on bytes above 0x7F, which a list
# of integers would hit wherever the text has UTF-8 in it. The array is constexpr, so the views are
# constant-initialized: nothing runs at DLL load.
#
# Used for the Lua prelude (Docs/Internal/script-tabs.md §3.9). Assets that are looked up at run
# time - fonts, icons, shaders - go through src/resource/ instead.

if(NOT OUTPUT OR NOT NAMESPACE OR NOT INPUTS)
    message(FATAL_ERROR "EmbedText.cmake: OUTPUT, NAMESPACE and INPUTS are required")
endif()

string(REPLACE "|" ";" _inputs "${INPUTS}")

set(_body "")
foreach(_input IN LISTS _inputs)
    get_filename_component(_stem "${_input}" NAME_WE)
    if(NOT _stem MATCHES "^[a-z_][a-z0-9_]*$")
        message(FATAL_ERROR "EmbedText.cmake: '${_input}' - the file stem must be a lower_case identifier")
    endif()

    file(READ "${_input}" _hex HEX)
    string(LENGTH "${_hex}" _hex_length)
    if(_hex_length EQUAL 0)
        message(FATAL_ERROR "EmbedText.cmake: '${_input}' is empty")
    endif()

    # 24 bytes to a line, then every byte as a character literal.
    string(REPEAT "[0-9a-f]" 48 _line)
    string(REGEX REPLACE "(${_line})" "\\1\n    " _hex "${_hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," _chars "${_hex}")

    file(RELATIVE_PATH _shown "${CMAKE_CURRENT_LIST_DIR}/.." "${_input}")
    string(APPEND _body
        "// ${_shown}\n"
        "inline constexpr char ${_stem}_bytes[] = {\n    ${_chars}\n};\n"
        "inline constexpr std::string_view ${_stem} { ${_stem}_bytes, sizeof(${_stem}_bytes) };\n\n")
endforeach()

# Every piece quoted: the text is full of ';', which an unquoted expansion would take for list separators.
string(CONCAT _text
    "// Generated by cmake/EmbedText.cmake - do not edit. Edit the source files named below and rebuild.\n"
    "#pragma once\n\n"
    "namespace ${NAMESPACE}\n{\n"
    "${_body}"
    "} // namespace ${NAMESPACE}\n")

# Only when the text changed, so a configure that reruns this does not force a recompile of its includer.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _previous)
    if(_previous STREQUAL _text)
        return()
    endif()
endif()

file(WRITE "${OUTPUT}" "${_text}")
