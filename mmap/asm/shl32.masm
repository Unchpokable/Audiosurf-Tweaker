.386
.model flat, stdcall

option casemap:none

OPTION PROLOGUE:NONE
OPTION EPILOGUE:NONE

.code

; EAX = pointer to CONTEXT32

MMAP_SHELL:

    pushad                      ; save all GP registers
    mov  esi, eax               ; esi = context*

    ; prepare call
    push esi                    ; Init(context)
    mov  ebx, [esi + 00h]       ; init_addr
    call ebx

    popad                       ; restore registers

    mov  eax, [esi + 08h]       ; ret_addr
    jmp  eax

END