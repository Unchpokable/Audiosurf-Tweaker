<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Needs a Windows SDK-versioned TFM (not bare net10.0-windows), same reason and fix as
         SkinChangerRestyle: the WinRT toast notification projection (ToastContentBuilder.Show())
         only resolves with a Windows SDK version on the TFM. This is Windows-only regardless
         (WM_COPYDATA/asbridge), so the extra specificity costs nothing on the rest of the project. -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<RootNamespace>TweakerUI</RootNamespace>
		<!-- Nullable inherited as "disable" from Directory.Build.props (project-wide policy from Phase 3a,
         to avoid unrelated annotation churn) - the wizard's own override is dropped. This module is a
         mechanical port of a large amount of pre-nullable WPF code; keeping it enabled would drown every
         build in CS8618 noise across dozens of ported properties for no functional benefit. -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Models\" />
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.5" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
		<PackageReference Include="Gameloop.Vdf" Version="0.6.2" />
		<PackageReference Include="Gameloop.Vdf.JsonConverter" Version="0.2.1" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="SkiaSharp" Version="4.150.0" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
	
    <!-- Not used directly - pinned up from the vulnerable floors pulled in transitively
         (Gameloop.Vdf.JsonConverter -> Newtonsoft.Json 12.0.3, GHSA-5crp-9r3c-p9vr;
         Microsoft.Toolkit.Uwp.Notifications -> System.Drawing.Common 4.7.0, GHSA-rxg9-xrhp-64gj).
         NuGet resolves to the highest floor across the graph, so a direct reference here is enough
         to override both without touching the packages that actually need them. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TweakerCore\TweakerCore.csproj" />
    <ProjectReference Include="..\AudiosurfInterface\AudiosurfInterface.csproj" />
    <ProjectReference Include="..\QuickPlayerCore\QuickPlayerCore.csproj" />
  </ItemGroup>

	<!--
    Same asbridge.exe pre-build hook as SkinChangerRestyle.csproj (Phase 3c) - AudiosurfHandle spawns
    it next to the exe at runtime, so without this the bridge subprocess is simply missing and the
    connection status sits in a permanent reconnect loop. CMake is still a black box here: no vcxproj,
    not in the .sln, Windows-only build/copy, skipped (not failed) on other platforms.
  -->
	<PropertyGroup>
		<AsBridgeSourceDir>$(MSBuildThisFileDirectory)..\ASBridge</AsBridgeSourceDir>
		<AsBridgeBuildDir>$(AsBridgeSourceDir)\build\msbuild</AsBridgeBuildDir>
	</PropertyGroup>

	<Target Name="BuildAsBridge" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<!-- The ‑‑fresh flag (CMake 3.24+) discards any existing cache before configuring. Without it,
		     a stale build dir - e.g. one that was ever configured while an outdated CMake or an
		     nmake/cl.exe-on-PATH shell (Visual Studio Developer Command Prompt) caused the wrong
		     generator to be picked - keeps reusing that wrong generator in CMakeCache.txt forever,
		     regardless of which shell invokes `cmake -S/-B` on it next. If that cached generator can't
		     honor -A Win32 (see BuildInjectHelper), the mismatch surfaces downstream as
		     "CMAKE_CXX_COMPILER not set after EnableLanguage". ‑‑fresh forces every configure to
		     re-resolve the generator from scratch; it only affects the configure step, not incremental
		     compilation in the build step below. -->
		<Exec Command="cmake --fresh -S &quot;$(AsBridgeSourceDir)&quot; -B &quot;$(AsBridgeBuildDir)&quot;" />
		<Exec Command="cmake --build &quot;$(AsBridgeBuildDir)&quot; --config Release" />
	</Target>

	<Target Name="CopyAsBridge" AfterTargets="BuildAsBridge" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PropertyGroup>
			<!-- Single-config generators (Ninja) emit to bin\, multi-config (Visual Studio) to bin\<Config>\. -->
			<AsBridgeExe>$(AsBridgeBuildDir)\bin\asbridge.exe</AsBridgeExe>
			<AsBridgeExe Condition="!Exists('$(AsBridgeExe)')">$(AsBridgeBuildDir)\bin\Release\asbridge.exe</AsBridgeExe>
		</PropertyGroup>
		<Error Condition="!Exists('$(AsBridgeExe)')" Text="asbridge.exe not found after CMake build at $(AsBridgeBuildDir)" />
		<Copy SourceFiles="$(AsBridgeExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

	<!--
    InjectHelper.exe must be a genuine 32-bit binary - Audiosurf (QuestViewer.exe) is a 32-bit
    process, and the injector's own remote-thread trick (GetProcAddress against its own,
    same-bitness kernel32.dll) only works when injector and target share bitness. This MSBuild
    target itself typically runs from an x64 Developer environment, so plain `cmake -S/-B`
    (which would follow the ambient PATH/INCLUDE/LIB) cannot be trusted to produce an x86 binary.
    The Visual Studio generator sidesteps that: with an explicit -A Win32 it resolves the x86
    cl.exe/link.exe toolset itself via the registered VS install, independent of the invoking
    shell's environment - no vcvarsall dance needed. No -G is passed on purpose: CMake's default
    generator already resolves to the newest installed Visual Studio (confirmed on this machine -
    "Visual Studio 18 2026" - while some vcxproj files elsewhere in the repo still pin the older
    v143/VS2022 toolset), and -A Win32 works the same way regardless of which VS version that is,
    so hardcoding a generator name here would only make this brittle across machines/VS updates.

    That default-resolves-to-VS-generator assumption depends on the `cmake` on PATH actually knowing
    the installed VS version's generator name. Hit in practice on this machine: the standalone Kitware
    CMake install was 4.1.2, which predates the "Visual Studio 18 2026" generator (added in CMake 4.2)
    - with no matching VS generator to fall back on, and a Developer Command Prompt's nmake/cl.exe
    already resolvable on PATH, CMake's auto-detection silently dropped to NMake Makefiles instead,
    which doesn't support -A Win32 and fails downstream with "CMAKE_CXX_COMPILER not set after
    EnableLanguage". Fix was upgrading the standalone CMake (`winget upgrade Kitware.CMake`), not
    pinning a -G here - keep the system CMake current with whatever VS version is installed. The
    ‑‑fresh flag below is a separate, complementary guard: once a build dir's CMakeCache.txt has a
    generator pinned (right or wrong), every later `cmake -S/-B` on it reuses that cached generator
    regardless of which shell invokes it next - ‑‑fresh forces every configure to re-resolve the
    generator from scratch instead of trusting a possibly-stale cache.
  -->
	<PropertyGroup>
		<InjectHelperSourceDir>$(MSBuildThisFileDirectory)..\InjectHelper</InjectHelperSourceDir>
		<InjectHelperBuildDir>$(InjectHelperSourceDir)\build\msbuild</InjectHelperBuildDir>
	</PropertyGroup>

	<Target Name="BuildInjectHelper" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<Exec Command="cmake --fresh -A Win32 -S &quot;$(InjectHelperSourceDir)&quot; -B &quot;$(InjectHelperBuildDir)&quot;" />
		<Exec Command="cmake --build &quot;$(InjectHelperBuildDir)&quot; --config Release" />
	</Target>

	<Target Name="CopyInjectHelper" AfterTargets="BuildInjectHelper" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PropertyGroup>
			<!-- Visual Studio generator is multi-config - always bin\<Config>\, no Ninja-style fallback needed. -->
			<InjectHelperExe>$(InjectHelperBuildDir)\bin\Release\InjectHelper.exe</InjectHelperExe>
		</PropertyGroup>
		<Error Condition="!Exists('$(InjectHelperExe)')" Text="InjectHelper.exe not found after CMake build at $(InjectHelperBuildDir)" />
		<Copy SourceFiles="$(InjectHelperExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

	<!--
    TweakerPlugin.dll (the in-game overlay, Phase 7b) - same -A Win32 reasoning as InjectHelper
    above, but unlike InjectHelper/asbridge this build is best-effort, not required: its
    CMakeLists.txt (TweakerPlugin/cmake/{DirectXSDK,Quest3DSDK,ImGui}.cmake) needs the DirectX
    SDK (June 2010), the proprietary Quest3D SDK, a vendored ImGui tree, and the Detours git
    submodule - none of which are guaranteed to be present on every machine/checkout (all
    gitignored except the Detours submodule). A missing prerequisite makes `cmake configure` exit
    non-zero with a precise FATAL_ERROR pointing at the fix (see those .cmake files) - IgnoreExitCode
    + reading the Output ExitCode below turns that into a <Warning> instead of failing the whole
    `dotnet build`, since the overlay is an opt-in [Experimental] Settings toggle and OverlayHelper
    already tolerates a missing TweakerPlugin.dll at runtime.

    Deliberately its own build/msbuild directory, distinct from the CMakePresets.json Ninja
    presets (build/x86-debug, build/x86-release) the developer uses locally for clangd's
    compile_commands.json - the two build trees never touch each other, so this never disturbs
    that workflow and never forces a from-scratch rebuild of Detours/DirectX/Quest3D/ImGui on
    every dotnet build (MSBuild's own incremental build applies here across repeated runs, same
    as it already does for ASBridge/InjectHelper above).
  -->
	<PropertyGroup>
		<TweakerPluginSourceDir>$(MSBuildThisFileDirectory)..\TweakerPlugin</TweakerPluginSourceDir>
		<TweakerPluginBuildDir>$(TweakerPluginSourceDir)\build\msbuild</TweakerPluginBuildDir>
	</PropertyGroup>

	<Target Name="BuildTweakerPlugin" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<Exec Command="cmake --fresh -A Win32 -S &quot;$(TweakerPluginSourceDir)&quot; -B &quot;$(TweakerPluginBuildDir)&quot;"
		      IgnoreExitCode="true" ContinueOnError="WarnAndContinue">
			<Output TaskParameter="ExitCode" PropertyName="TweakerPluginConfigureExitCode" />
		</Exec>
		<Warning Condition="'$(TweakerPluginConfigureExitCode)' != '0'"
		         Text="TweakerPlugin CMake configure failed (exit $(TweakerPluginConfigureExitCode)) - likely a missing DirectX SDK / Quest3D SDK / ImGui / Detours submodule (see TweakerPlugin/cmake/*.cmake for exact setup steps). Skipping the in-game overlay plugin for this build; TweakerUI itself is unaffected." />

		<Exec Command="cmake --build &quot;$(TweakerPluginBuildDir)&quot; --config Release"
		      Condition="'$(TweakerPluginConfigureExitCode)' == '0'"
		      IgnoreExitCode="true" ContinueOnError="WarnAndContinue">
			<Output TaskParameter="ExitCode" PropertyName="TweakerPluginBuildExitCode" />
		</Exec>
		<Warning Condition="'$(TweakerPluginConfigureExitCode)' == '0' AND '$(TweakerPluginBuildExitCode)' != '0'"
		         Text="TweakerPlugin build failed (exit $(TweakerPluginBuildExitCode)). Skipping the in-game overlay plugin for this build." />
	</Target>

	<Target Name="CopyTweakerPlugin" AfterTargets="BuildTweakerPlugin" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PropertyGroup>
			<TweakerPluginDll>$(TweakerPluginBuildDir)\bin\Release\TweakerPlugin.dll</TweakerPluginDll>
		</PropertyGroup>
		<!--
		    The plugin's Lua scripts are loose files it loads from a scripts/ directory beside itself
		    at runtime (see TweakerPlugin/src/lua/lua_host.cxx), deliberately - they are meant to be
		    edited without a rebuild. That makes them part of the payload, not build intermediates:
		    copying only the dll here would ship a scripting layer with nothing to run.
		-->
		<ItemGroup>
			<TweakerPluginScripts Include="$(TweakerPluginSourceDir)\assets\scripts\**\*" />
		</ItemGroup>
		<!-- No <Error> here - a missing dll just means the overlay wasn't built this time (see above). -->
		<Copy SourceFiles="$(TweakerPluginDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
		      Condition="Exists('$(TweakerPluginDll)')" />
		<Copy SourceFiles="@(TweakerPluginScripts)" DestinationFolder="$(OutDir)scripts\%(RecursiveDir)" SkipUnchangedFiles="true"
		      Condition="Exists('$(TweakerPluginDll)')" />
	</Target>
</Project>
