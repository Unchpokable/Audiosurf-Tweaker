<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Bridge status row's reset button (see Button.IconResetButton below). -->
        <StreamGeometry x:Key="IconReset">M1 4v6h6 M3.51 15a9 9 0 1 0 2.13-9.36L1 10</StreamGeometry>

        <!-- Fully retemplated rather than styled through Setters: FluentTheme's built-in TextBox
        template draws its own accent-colored focus ring on a template-internal part that a plain
        Setter can't reach, which produced a thick, badly-placed focus outline. Owning the whole
        template means the only focus feedback is the BorderBrush swap in the Style below - thin
        and intentional. Shared by TextBox.CCNameInput and TextBox.CCHexInput. -->
        <!-- No ScrollViewer: these fields are short (name/hex), never wrap, and the ScrollViewer's
        viewport layout was fighting TextPresenter's own vertical centering and selection-highlight
        positioning (text and its selection box were rendering low and slightly offset from each
        other). TextPresenter alone, directly in the padded Border, centers correctly on its own. -->
        <ControlTemplate x:Key="CCTextBoxTemplate" TargetType="TextBox">
            <Border Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    </Transitions>
                </Border.Transitions>
                <Panel>
                    <TextBlock Name="PART_Watermark"
                               Opacity="0.5"
                               Text="{TemplateBinding Watermark}"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    <TextPresenter Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                   CaretIndex="{TemplateBinding CaretIndex}"
                                   SelectionStart="{TemplateBinding SelectionStart}"
                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   TextWrapping="NoWrap"
                                   SelectionBrush="{DynamicResource AccentSelectionBrush}"
                                   SelectionForegroundBrush="{DynamicResource TextOnAccentBrush}"
                                   CaretBrush="{TemplateBinding CaretBrush}"
                                   VerticalAlignment="Center"/>
                </Panel>
            </Border>
        </ControlTemplate>
    </Styles.Resources>

    <!-- Custom window chrome buttons (minimize/maximize/close) hosted in MainWindow's own title bar,
    since SystemDecorations="None" means there is no native title bar to style instead. -->
    <Style Selector="Button.TitleBarButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.TitleBarButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button.TitleBarButtonClose:pointerover">
        <Setter Property="Background" Value="#FFE81123"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- Left-menu navigation row - matches the old WPF SimpleLeftMenuRadioButton exactly in spirit:
    no background box at all, selection reads purely from a text-color change plus a thin purple
    accent bar on the left edge (the old app's 5px "bullet" strip). Foreground/accent-bar changes
    both transition, which is the animation groundwork - later states (or real .axaml Animations)
    slot into the same Transitions without touching the template again. -->
    <Style Selector="RadioButton.NavItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="4,*">
                    <Border Name="AccentBar"
                            Grid.Column="0"
                            Background="Transparent"
                            CornerRadius="2"
                            Margin="0,6">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}">
                        <ContentPresenter.Transitions>
                            <Transitions>
                                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                            </Transitions>
                        </ContentPresenter.Transitions>
                    </ContentPresenter>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.NavItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="RadioButton.NavItem:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.NavItem:checked /template/ Border#AccentBar">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>

    <!-- Bridge connection controls: the real Audiosurf Tweaker palette is white-and-purple, not gray -
    this matches the old UnderscoredButton style almost exactly. -->
    <Style Selector="Button.UnderscoredButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                        </Transitions>
                    </Border.Transitions>
                    <Grid RowDefinitions="*,3">
                        <ContentPresenter Grid.Row="0"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"/>
                        <Border Name="Underscore" Grid.Row="1" Background="{DynamicResource AccentPrimaryBrush}" Margin="14,0,14,0">
                            <Border.Transitions>
                                <Transitions>
                                    <ThicknessTransition Property="Margin" Duration="0:0:0.15"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.UnderscoredButton:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="#FFD1F7FF"/>
    </Style>
    <Style Selector="Button.UnderscoredButton:pointerover /template/ Border#Underscore">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Button.UnderscoredButton:pressed /template/ Border#Root">
        <Setter Property="Background" Value="#FFA7B8FF"/>
    </Style>

    <!-- Small icon-only reset button next to the status dot (replaces the old full-width "Reset" text
    button + "Auto" button pair - auto-handling is now the bridge subprocess's own always-on behavior,
    so the button for it was removed rather than kept as a no-op). -->
    <Style Selector="Button.IconResetButton">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.IconResetButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.IconResetButton:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>

    <!-- ============================================================================
    Color Configurator (stage 4.2) - ported from the "Palette Designer" Claude Design
    mockup. Its soft-purple palette became the source of truth for the app-wide accent
    consistency pass (2026-07-13, see Themes/AccentColors.axaml): every module's own ad
    hoc purple token, including the app shell's own #9d5bf5 family above, now flows
    through the same three centralized resources instead of picking its own by eye.
    ============================================================================ -->

    <Style Selector="Border.CCCard">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style Selector="Border.CCCardPad20">
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.CCListCard">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="TextBlock.CCHeading">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.CCSubHeading">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Border.CCBadge">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="TextBlock.CCBadgeText">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
    </Style>
    <Style Selector="TextBlock.CCSmallLabel">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
    </Style>
    <Style Selector="TextBlock.CCEditingLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
    </Style>
    <Style Selector="TextBlock.CCSliderLabel">
        <Setter Property="Width" Value="16"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.CCSliderValue">
        <Setter Property="Width" Value="42"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="TextBox.CCNameInput">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="Template" Value="{StaticResource CCTextBoxTemplate}"/>
    </Style>
    <Style Selector="TextBox.CCNameInput:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="TextBox.CCNameInput:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBox.CCHexInput">
        <Setter Property="Width" Value="110"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="Template" Value="{StaticResource CCTextBoxTemplate}"/>
    </Style>
    <Style Selector="TextBox.CCHexInput:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="TextBox.CCHexInput:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>

    <!-- Palette list rows: transitions carry the "selected" highlight in/out smoothly instead of a
    hard cut, same baseline established for NavItem/UnderscoredButton in 4.1. -->
    <Style Selector="Border.CCAccentBar">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.CCAccentBar.Selected">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
    </Style>
    <Style Selector="TextBlock.CCPaletteName">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.CCPaletteName.Selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <Style Selector="Button.CCPaletteRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}" Margin="12,10"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.CCPaletteRow:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.CCPaletteRow.Selected /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>

    <Style Selector="Button.CCNewPalette">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="0,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.CCNewPalette:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>

    <Style Selector="Button.CCNegative">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.CCNegative:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>

    <!-- Rectangular (not square) core-color swatches: a full 96x96 grid of 5 squares ate a lot of
    vertical room for little benefit on a desktop window - same recognizability at a fraction of the
    height. Selection uses an accent border + soft glow rather than a background box, echoing the
    text-color-only selection language used for NavItem. -->
    <Style Selector="Border.CCSwatchChip">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="#14000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Border isn't focusable by default; without this, clicking a swatch can't take keyboard
        focus away from the name TextBox (see code-behind's explicit Focus() call on click). -->
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 #0F000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.CCSwatchChip.Selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="BoxShadow" Value="0 4 12 0 #477A4FC7"/>
    </Style>
    <Style Selector="TextBlock.CCSwatchLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.CCSwatchLabel.Selected">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <Style Selector="Border.CCWheelWrap">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Border.CCCurrentColorBox">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.CCTabsWrap">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="Button.CCTab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.CCTab:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button.CCTab.Selected">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.CCTab.Selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <Style Selector="Border.CCSaveBar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style Selector="Border.CCGamePanel">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector="TextBlock.CCGamePanelTitle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <!-- Shared gradient CTA (Save Bar's "Apply changes" and the game panel's "Apply to game"). -->
    <Style Selector="Button.CCGradientButton">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.CCGradientButton:pointerover">
        <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.CCGradientButton:pressed">
        <Setter Property="Opacity" Value="0.82"/>
    </Style>

    <Style Selector="Button.CCSecondary">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.CCSecondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <Style Selector="Button.CCGhost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.CCGhost:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <Style Selector="Button.CCDiscard">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.CCDiscard:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
</Styles>
