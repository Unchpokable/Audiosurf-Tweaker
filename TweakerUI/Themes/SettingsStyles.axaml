<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:TweakerUI.Core">

    <!-- ============================================================================
    Settings (stage 4.6) - no mockup, laid out "on the eye" like Tweaker's Command and Control tab:
    a single scrollable page of card sections rather than the donor's WPF TabControl, to match the
    rest of the app (Tweaker/Skin Changer/Color Configurator are all single-page card layouts too).
    Kept in its own file per the same per-module scoping as SkinChangerStyles.axaml/TweakerStyles.axaml.
    "ST" prefix; accent colors flow through Themes/AccentColors.axaml (2026-07-13 consistency pass).
    Toggle rows here skip the
    per-item icon column Tweaker's toggles use - these read as ordinary preference switches (label +
    switch), not tweaks tied to a concrete visual concept, so an icon per row would be decoration
    without a clear referent.
    ============================================================================ -->

    <!-- Cards, card titles, toggle rows/labels and switches are the shared ones from SharedStyles.axaml.
    What follows is Settings' own. -->

    <!-- Sub-toggles that only make sense when a parent switch is on (e.g. Safety installation under
    Control textures folder, or the two Watcher sub-options) - indented, and dimmed by ToggleRow's own
    :disabled style instead of hidden, so the dependency reads as "off because the parent is off"
    rather than vanishing entirely. -->
    <Style Selector="Border.ToggleRow.STNested">
        <Setter Property="Margin" Value="22,0,0,0"/>
    </Style>

    <Style Selector="TextBlock.STToggleHint">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Path/file rows -->
    <Style Selector="TextBlock.STFieldLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
        <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>
    <Style Selector="TextBox.STPathBox">
        <!-- Medium rather than the default Regular weight - Inter at Regular/13.5px read as thin
        and slightly harsh against the field's light background (per direct feedback); Medium is
        still clearly a "field", not a heading, but renders smoother at this size. -->
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource FlatTextBoxTemplate}"/>
    </Style>
    <Style Selector="TextBox.STPathBox:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="TextBox.STPathBox:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.STBrowseButton">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style Selector="Button.STBrowseButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>
    <Style Selector="Button.STBrowseButton:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

</Styles>
