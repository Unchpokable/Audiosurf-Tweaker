<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================
    Skin Changer (stage 4.3) - ported from the "Audiosurf Tweaker" Claude Design mockup.
    Kept in its own file (rather than appended to the shared Themes/Styles.axaml) so each
    module's styling stays easy to find; the "SC" prefix mirrors the "CC" prefix already
    used for the Color Configurator's own file-scoped styles. This module's own mockup
    accent purple (#6C4CE0) was replaced in the 2026-07-13 consistency pass - every accent
    usage here now flows through Themes/AccentColors.axaml's centralized resources instead.
    ============================================================================ -->

    <Styles.Resources>
        <!-- Icon glyphs traced straight from the mockup's inline SVG paths rather than sourced from
        Properties.Resources PNGs, since the mockup draws every action icon as a plain feather-style
        stroke path. Geometry only; color/size are set per usage so the same key works for both the
        icon rail and the smaller per-row buttons. -->
        <StreamGeometry x:Key="IconAdd">M12 5v14 M5 12h14</StreamGeometry>
        <StreamGeometry x:Key="IconImportGame">M12 3v10 M8 9l4 4 4-4 M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M21 12a9 9 0 1 1-3-6.7 M21 4v6h-6</StreamGeometry>
        <StreamGeometry x:Key="IconInstall">M12 3v12 M7 11l5 5 5-5 M5 20h14</StreamGeometry>
        <StreamGeometry x:Key="IconExport">M14 4h6v6 M20 4l-9 9 M18 13v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h6</StreamGeometry>
        <StreamGeometry x:Key="IconRename">M11 4h-6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6 M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z</StreamGeometry>
        <StreamGeometry x:Key="IconDelete">M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6</StreamGeometry>
        <StreamGeometry x:Key="IconSky">M6.5 18a4 4 0 0 1-.4-7.98A5.5 5.5 0 0 1 16.9 8.1 4.2 4.2 0 0 1 16.5 18h-10z</StreamGeometry>
        <StreamGeometry x:Key="IconRings">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 2a7 7 0 1 1 0 14 7 7 0 0 1 0-14zm0 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6z</StreamGeometry>
        <StreamGeometry x:Key="IconTile">M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z</StreamGeometry>
        <StreamGeometry x:Key="IconHits">M12 2l1.7 5.1L19 9l-5.3 1.9L12 16l-1.7-5.1L5 9l5.3-1.9z</StreamGeometry>
        <StreamGeometry x:Key="IconParticles">M5 5h3v3H5zM16 4h2.4v2.4H16zM11 10l1.4 4.2L16.6 16l-4.2 1.4L11 21.6 9.6 17.4 5.4 16l4.2-1.4z</StreamGeometry>

        <!-- Self-contained rename field template, deliberately not sharing Color Configurator's
        CCTextBoxTemplate - keeping this file's resources local avoids reaching into another
        module's stylesheet for something this small. -->
        <ControlTemplate x:Key="SCRenameInputTemplate" TargetType="TextBox">
            <Border Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    </Transitions>
                </Border.Transitions>
                <TextPresenter Name="PART_TextPresenter"
                               Text="{TemplateBinding Text, Mode=TwoWay}"
                               CaretIndex="{TemplateBinding CaretIndex}"
                               SelectionStart="{TemplateBinding SelectionStart}"
                               SelectionEnd="{TemplateBinding SelectionEnd}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="NoWrap"
                               SelectionBrush="{DynamicResource AccentSelectionBrush}"
                               SelectionForegroundBrush="{DynamicResource TextOnAccentBrush}"
                               CaretBrush="{TemplateBinding CaretBrush}"
                               VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
    </Styles.Resources>

    <!-- Section cards - visual consistency pass with Color Configurator's own CCCard/CCGamePanel
    (same tokens, kept under the SC prefix rather than reused directly, per this module's own
    file-scoping). Applied to the top bar, skins list, screenshots panel and Custom Installation. -->
    <Style Selector="Border.SCCard">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style Selector="Border.SCGamePanelCard">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- Left icon rail (Add / Import from Game / Refresh) -->
    <Style Selector="Button.SCIconButton">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SCIconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.SCIconButton:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- Per-skin-row action buttons (Install / Export / Rename / Delete) -->
    <Style Selector="Button.SCRowIconButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SCRowIconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.SCRowIconButton.Danger:pointerover">
        <Setter Property="Background" Value="#1FDC3C3C"/>
    </Style>

    <!-- Skins list -->
    <Style Selector="ListBox.SCSkinsList">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.SCSkinsList ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceRowBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.SCSkinsList ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceRowHoverBrush}"/>
    </Style>
    <!-- The mockup's own literal #B7C3F7 read as too bright/blue against real skin data - shifted
    toward the app's purple accent family and toned down a notch. -->
    <Style Selector="ListBox.SCSkinsList ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AccentSelectedBrush}"/>
    </Style>
    <Style Selector="ListBox.SCSkinsList ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSelectedBrush}"/>
    </Style>

    <Style Selector="TextBlock.SCSkinName">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Loading placeholders: no screenshot/skin-list caching (deliberately, to keep memory down), so
    a re-selected skin always re-decodes - this pulsing block fills the gap instead of an empty list. -->
    <Style Selector="Border.SCSkeletonPulse">
        <Style.Animations>
            <Animation Duration="0:0:1.2" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.5"/>
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.5"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.SCSkinRowSkeleton">
        <Setter Property="Height" Value="66"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSkeletonBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="TextBox.SCRenameInput">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="Template" Value="{StaticResource SCRenameInputTemplate}"/>
    </Style>

    <!-- Top bar -->
    <Style Selector="TextBlock.SCTopBarLabel">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.SCTopBarValue">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <!-- Screenshots panel. Height is no longer fixed here - AspectRatioBox (16:9) in the view derives
    it from the available width, so stretching the window scales the tile instead of cropping it. -->
    <Style Selector="Border.SCScreenshotItem">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{DynamicResource MediaGradientTopColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource MediaGradientBottomColor}" Offset="1"/>
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="Border.SCScreenshotSkeleton">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSkeletonBrush}"/>
    </Style>
    <Style Selector="TextBlock.SCEmptyState">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Custom Installation bar -->
    <Style Selector="TextBlock.SCSectionTitle">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton.SCSwitch">
        <Setter Property="Template" Value="{StaticResource AccentSwitchTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.SCSwitch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.SCSwitch:checked /template/ Border#Thumb">
        <Setter Property="Margin" Value="16,0,0,0"/>
    </Style>

    <Style Selector="Path.SCToggleIcon">
        <Setter Property="Fill" Value="{DynamicResource TextGlyphMutedBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SCToggleGroup.On Path.SCToggleIcon">
        <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.SCToggleLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.SCToggleDivider">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- Install Selected / Clear Selected segmented control -->
    <Style Selector="Border.SCSegmentWrap">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- HorizontalAlignment/VerticalContentAlignment set explicitly (not just HorizontalContentAlignment)
    - the Fluent theme's default Button sizes to its content unless told to fill, which left the text
    hugging the left edge of the Grid column instead of centering across it. -->
    <Style Selector="Button.SCSegment">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="0,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SCSegment:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>
    <Style Selector="Button.SCSegment:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

</Styles>
