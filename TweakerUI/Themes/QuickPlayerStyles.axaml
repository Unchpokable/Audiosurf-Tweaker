<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================
    QuickPlayer (Фаза 5) - no mockup this time, laid out from the user's verbal description and
    iterated visually from there. "QP" prefix, own file per the established per-module scoping
    (SC/TW/ST/CC/SB). Reuses established fixes rather than rediscovering them: ListBoxItem/TextBox
    need their own full ControlTemplate or the FluentTheme default paints selection/focus straight
    on a template-internal part and wins over a plain Setter (see SkinChangerStyles.axaml's
    SCSkinListItemTemplate / SettingsStyles.axaml's STTextBoxTemplate for the original diagnosis).
    ============================================================================ -->

    <Styles.Resources>
        <!-- These four (the transport bar) had their bounding boxes NOT anchored at (0,0) - e.g. Prev's
        original "M11 19l-9-7 9-7v14z M20 19l-9-7 9-7v14z" occupies x:[2,20] y:[5,19], not x:[0,18]
        y:[0,14]. Path's default Stretch is None, which does not translate the geometry to its own
        bounding-box origin before rendering - the unused margin between (0,0) and the geometry's real
        top-left silently became part of the rendered content's layout box, which is what was pushing
        every transport icon toward the bottom-right of its button regardless of Viewbox/Stretch/
        alignment settings layered on top (Fuckups/buttons_alignment_wrong.png). Recomputed by hand so
        each geometry's bounding box starts exactly at (0,0) - same shapes, offset subtracted out. -->
        <StreamGeometry x:Key="IconQPPrev">M9 14L0 7L9 0Z M18 14L9 7L18 0Z</StreamGeometry>
        <StreamGeometry x:Key="IconQPNext">M9 0L18 7L9 14Z M0 0L9 7L0 14Z</StreamGeometry>
        <StreamGeometry x:Key="IconQPPlay">M0 0L0 14L11 7Z</StreamGeometry>
        <StreamGeometry x:Key="IconQPStop">M0 0h12v12H0z</StreamGeometry>
        <StreamGeometry x:Key="IconQPAdd">M12 5v14 M5 12h14</StreamGeometry>
        <StreamGeometry x:Key="IconQPRemove">M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13</StreamGeometry>
        <StreamGeometry x:Key="IconQPCoverPlaceholder">M9 18V6l11-2v12 M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M17 19a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
        <StreamGeometry x:Key="IconQPCharacterPlaceholder">M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7</StreamGeometry>
        <!-- Same pencil glyph as SkinChangerStyles.axaml's IconRename - duplicated under this
        module's own prefix per the established per-file icon scoping, not shared directly. -->
        <StreamGeometry x:Key="IconQPRename">M11 4h-6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6 M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z</StreamGeometry>

        <!-- Own template - see file header note. Used for both the playlist sidebar and the queue. -->
        <ControlTemplate x:Key="QPListItemTemplate" TargetType="ListBoxItem">
            <Border Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    </Transitions>
                </Border.Transitions>
                <ContentPresenter Content="{TemplateBinding Content}"
                                   ContentTemplate="{TemplateBinding ContentTemplate}"
                                   Padding="{TemplateBinding Padding}"
                                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="QPParamInputTemplate" TargetType="TextBox">
            <Border Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    </Transitions>
                </Border.Transitions>
                <TextPresenter Name="PART_TextPresenter"
                               Text="{TemplateBinding Text, Mode=TwoWay}"
                               CaretIndex="{TemplateBinding CaretIndex}"
                               SelectionStart="{TemplateBinding SelectionStart}"
                               SelectionEnd="{TemplateBinding SelectionEnd}"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               SelectionBrush="{DynamicResource AccentSelectionBrush}"
                               SelectionForegroundBrush="{DynamicResource TextOnAccentBrush}"
                               CaretBrush="{TemplateBinding CaretBrush}"
                               VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="QPRenameInputTemplate" TargetType="TextBox">
            <Border Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    </Transitions>
                </Border.Transitions>
                <TextPresenter Name="PART_TextPresenter"
                               Text="{TemplateBinding Text, Mode=TwoWay}"
                               CaretIndex="{TemplateBinding CaretIndex}"
                               SelectionStart="{TemplateBinding SelectionStart}"
                               SelectionEnd="{TemplateBinding SelectionEnd}"
                               TextAlignment="Left"
                               TextWrapping="NoWrap"
                               SelectionBrush="{DynamicResource AccentSelectionBrush}"
                               SelectionForegroundBrush="{DynamicResource TextOnAccentBrush}"
                               CaretBrush="{TemplateBinding CaretBrush}"
                               VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
    </Styles.Resources>

    <!-- Cards -->
    <Style Selector="Border.QPCard">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style Selector="TextBlock.QPCardTitle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
    </Style>
    <Style Selector="TextBlock.QPEmptyState">
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- Small icon buttons: add playlist, add tracks, remove playlist -->
    <Style Selector="Button.QPIconButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource AccentGhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style Selector="Button.QPIconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- Playlist sidebar -->
    <Style Selector="ListBox.QPPlaylistList">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.QPPlaylistList ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource QPListItemTemplate}"/>
    </Style>
    <Style Selector="ListBox.QPPlaylistList ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceRowHoverBrush}"/>
    </Style>
    <Style Selector="ListBox.QPPlaylistList ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AccentSelectedBrush}"/>
    </Style>
    <Style Selector="ListBox.QPPlaylistList ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSelectedBrush}"/>
    </Style>
    <Style Selector="TextBlock.QPPlaylistName">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Same TextFaintBrush-vs-AccentSelectedBrush contrast problem as QPTrackDuration - see that
    style's comment. -->
    <Style Selector="TextBlock.QPPlaylistCount">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBox.QPRenameInput">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="Template" Value="{StaticResource QPRenameInputTemplate}"/>
    </Style>
    <!-- Small row-level icon button, e.g. the per-playlist rename trigger. -->
    <Style Selector="Button.QPRowIconButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style Selector="Button.QPRowIconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- Queue -->
    <Style Selector="ListBox.QPQueueList">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.QPQueueList ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceRowBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource QPListItemTemplate}"/>
    </Style>
    <Style Selector="ListBox.QPQueueList ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceRowHoverBrush}"/>
    </Style>
    <Style Selector="ListBox.QPQueueList ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AccentSelectedBrush}"/>
    </Style>
    <Style Selector="ListBox.QPQueueList ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSelectedBrush}"/>
    </Style>
    <!-- Background MUST be an explicit brush (Transparent counts, unset/null does not) - an
    unset Background makes a Border's empty area transparent to hit-testing in Avalonia, which was
    silently swallowing right-clicks anywhere except directly over a child that had its own
    Background (the cover box) - ContextFlyout never even saw the pointer event on the rest of the
    card. The visible row color itself already comes from the ListBoxItem template underneath
    (see ListBox.QPQueueList ListBoxItem above); this Border only needs to be hit-testable and to
    own the "now playing" accent outline below. -->
    <Style Selector="Border.QPTrackCard">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Now-playing highlight wins over selection - Classes.Playing is set from IsPlaying, applied
    on the card border inside the item template (not the ListBoxItem itself, so it composes with
    the normal selection background instead of fighting it). -->
    <Style Selector="Border.QPTrackCard.Playing">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Border.QPTrackCover">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Path.QPCoverPlaceholderIcon">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource TextGlyphMutedBrush}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <Style Selector="TextBlock.QPTrackTitle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.QPTrackArtist">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- TextFaintBrush read as basically invisible against AccentSelectedBrush in dark theme once a
    row was selected (Fuckups/on_selected_text_color_invisible.png) - TextMutedBrush keeps it
    reading as secondary/quiet text but holds contrast against both the normal row surface and the
    accent-tinted selected one. -->
    <Style Selector="TextBlock.QPTrackDuration">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Badges - active tags/mods on the title row, audio properties on the artist row. Same chip
    shape as the status bar's SBChip, smaller/plainer since these are dense inline metadata, not
    standalone status. -->
    <Style Selector="Border.QPBadge">
        <Setter Property="Background" Value="{DynamicResource SurfaceBadgeBrush}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,2"/>
        <!-- Bottom margin matters here specifically: these sit in a WrapPanel (unlike StackPanel,
        WrapPanel has no Spacing property), so without it wrapped lines had zero vertical gap and
        visually fused together (Fuckups/too_tight_tags.png). -->
        <Setter Property="Margin" Value="0,0,5,5"/>
    </Style>
    <Style Selector="TextBlock.QPBadgeText">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
    </Style>
    <Style Selector="Border.QPBadge.Active">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Border.QPBadge.Active TextBlock.QPBadgeText">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <!-- Background is a real (if subtle) surface color, not Transparent - on a selected row
    (AccentSelectedBrush) an AccentPrimaryBrush-stroked icon sitting directly on that same accent
    tint nearly disappeared, same root cause as the duration text above. A static chip color keeps
    the icon on a non-accent backdrop regardless of row selection. -->
    <Style Selector="Button.QPTrackRemoveButton">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style Selector="Button.QPTrackRemoveButton:pointerover">
        <Setter Property="Background" Value="#1FDC3C3C"/>
    </Style>

    <!-- Transport bar -->
    <Style Selector="Border.QPTransportBar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>
    <!-- VerticalAlignment matters here specifically: these sit in a horizontal StackPanel next to
    the taller .Primary (Play) button, and Button's default VerticalAlignment is Stretch - a fixed
    Height under Stretch alignment anchors to the TOP of its row slot instead of centering, which is
    exactly why Prev/Stop/Next sat visibly higher than Play (Fuckups/buttons_alignment_wrong.png).
    Forced Center here for the row cross-axis; HorizontalAlignment/VerticalAlignment on the icon
    Paths themselves (QuickPlayerView.axaml) additionally guard the icon's own centering within its
    button regardless of ContentPresenter behavior. -->
    <Style Selector="Button.QPTransportButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="{DynamicResource AccentGhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    </Style>
    <Style Selector="Button.QPTransportButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <!-- Was missing entirely - a disabled Stop button (nothing playing yet) looked completely
    identical to an enabled one, just inert, which read as broken rather than "correctly disabled". -->
    <Style Selector="Button.QPTransportButton:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.QPTransportButton.Primary">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource AccentButtonGradientBrush}"/>
    </Style>

    <!-- Character grid - RadioButton restyled as a rectangular chip, same "restyle a semantically
    exclusive control rather than hand-roll exclusivity" approach as RadioButton.NavItem. Sits inside
    a UniformGrid (see QuickPlayerView.axaml) - UniformGrid gives every child an equal-size cell, but
    a RadioButton's own default HorizontalAlignment/HorizontalContentAlignment is Left/Center rather
    than Stretch, so without explicitly stretching both the control and its template root, each chip
    still only draws itself as wide as its own text, leaving ragged empty gaps in the wider cells
    ("dancing buttons" - Fuckups/dancing_buttons.png). Forcing Stretch end to end (control ->
    template root Border -> inner content) makes every chip actually fill its uniform cell. -->
    <Style Selector="RadioButton.QPCharacterButton">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinWidth" Value="54"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                        </Transitions>
                    </Border.Transitions>
                    <StackPanel Spacing="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Path Name="Icon" Data="{StaticResource IconQPCharacterPlaceholder}"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent">
                            <Path.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Stroke" Duration="0:0:0.15"/>
                                </Transitions>
                            </Path.Transitions>
                        </Path>
                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" TextAlignment="Center"
                                   TextWrapping="Wrap" HorizontalAlignment="Stretch"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.QPCharacterButton:pointerover /template/ Border#Root">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>
    <Style Selector="RadioButton.QPCharacterButton:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="RadioButton.QPCharacterButton:checked /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>

    <!-- Shared toggle switch, same shape as TWSwitch/STSwitch under this module's own prefix. -->
    <Style Selector="ToggleButton.QPSwitch">
        <Setter Property="Template" Value="{StaticResource AccentSwitchTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.QPSwitch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.QPSwitch:checked /template/ Border#Thumb">
        <Setter Property="Margin" Value="16,0,0,0"/>
    </Style>

    <!-- Right-click track menu (Flyout content, not MenuItem-based - needs toggles/text inputs,
    not just commands). -->
    <!-- Widened from an initial 320 - at 320 the 7-wide character grid squeezed each cell down to
    ~38px, forcing labels like "Double Vision" to wrap mid-word, and the Tags column left barely
    enough room for "Percentage of white/black blocks" without wrapping either
    (Fuckups/too_tight_layout.png, Characters_override_too_tight.png). -->
    <Style Selector="Border.QPMenuPanel">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Width" Value="440"/>
    </Style>
    <Style Selector="TextBlock.QPMenuSectionTitle">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}"/>
        <Setter Property="Margin" Value="0,14,0,8"/>
    </Style>
    <Style Selector="TextBlock.QPMenuSectionTitle.First">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="TextBlock.QPMenuLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Margin (not just spacing between ItemsControl children) since each row is the DataTemplate
    root placed straight into a plain StackPanel - MinHeight keeps single-line rows from feeling
    thinner than wrapped two-line ones. Was 6px with no MinHeight, which read as one solid block of
    controls (Fuckups/too_tight_layout.png). -->
    <Style Selector="Grid.QPMenuRow">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>

    <!-- Parameter input for tags like [as-msz&lt;X&gt;] - fixed-width column reserved whether or not
    a given row actually has one, so the toggle column always lines up regardless (see
    QuickPlayerView.axaml's per-row Grid: the column is a literal pixel width, not Auto, so an
    IsVisible="False" TextBox still reserves its space). -->
    <Style Selector="TextBox.QPParamInput">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource QPParamInputTemplate}"/>
    </Style>
    <Style Selector="TextBox.QPParamInput:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>
    <Style Selector="TextBox.QPParamInput:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>

</Styles>
