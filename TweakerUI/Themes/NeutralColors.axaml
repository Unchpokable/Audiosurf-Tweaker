<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================
    Neutral palette (Фаза 4.7, step 1, 2026-07-13) - the gray/white/border/text scale that
    every module's Styles file and View previously hardcoded "by eye" per usage (the same
    problem the purple accent had before Themes/AccentColors.axaml). This is the larger of
    the two remaining pieces before dark theme switching (see roadmap): AccentColors.axaml
    covers the purple family, this file covers everything else that isn't a semantic status
    color (danger red, box-shadow black, translucent scrims stay local - see the "explicitly
    left alone" list in the roadmap for why).

    Dark palette extracted (2026-07-13, Фаза 4.7 step 2) from the user's "Palette Designer -
    Dark" Claude Design mockup. That mockup only renders one screen (Color Configurator), so
    it directly gives values for AppBackground/Surface/SurfaceMuted(nb)/SurfaceSoft/
    SurfaceHover/SurfaceInput/Border/BorderSubtle/TextPrimary/TextMuted/TextFaint/TextOnAccent
    (see per-key comments below for which). Two roles the mockup's own style objects clearly
    treat as their own distinct tier - not reducible to any existing token without a visible
    mismatch - were added as new tokens rather than force-fit into an existing one:
    SurfaceBadgeColor (badge chips read distinctly lighter than the general soft-fill tier in
    dark) and SurfaceElevatedColor (the selected settings-tab / a hovered secondary button read
    distinctly lighter than the general hover tier in dark). Everything else without a direct
    mockup equivalent (this app has several surfaces - Skin Changer's row list, skeleton
    placeholders, window chrome - the single-screen mockup doesn't show) was interpolated
    against the values that ARE given, following the same lightness ordering the mockup's own
    tokens establish; flagged per-key below. Treat those as a first pass pending visual QA once
    the theme can actually be switched on screen, not as extracted-and-final the way the direct
    ones are.
    ============================================================================ -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Surfaces -->
            <Color x:Key="AppBackgroundColor">#FFF2F2F4</Color>
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="SurfaceMutedColor">#FFEDEDED</Color>
            <Color x:Key="SurfaceSoftColor">#FFF4F5F7</Color>
            <Color x:Key="SurfaceHoverColor">#FFF0F0F3</Color>
            <Color x:Key="SurfaceInputColor">#FFFAFAFB</Color>
            <Color x:Key="SurfaceRowColor">#FFECECEC</Color>
            <Color x:Key="SurfaceRowHoverColor">#FFE2E2E2</Color>
            <Color x:Key="SurfaceSkeletonColor">#FFE0E0E4</Color>
            <!-- Matches the mockup's own badgeBg (light) almost exactly - previously folded into
            SurfaceSoftColor before the dark mockup showed the two roles need to diverge (see file
            header); split out here too so both themes use the same token for the same role. -->
            <Color x:Key="SurfaceBadgeColor">#FFF1F2F5</Color>
            <!-- Matches SurfaceColor in Light (mockup's selected-tab background is plain white,
            same as any other card) - exists as its own token purely so Dark can diverge; see
            SurfaceElevatedColor's Dark comment. -->
            <Color x:Key="SurfaceElevatedColor">#FFFFFFFF</Color>
            <!-- Zero-alpha SurfaceHoverColor. Exactly the same trick, and for exactly the same reason,
            as AccentColors.axaml's AccentGhostColor - see the block comment on SurfaceHoverGhostBrush
            below for why a control that fades in to SurfaceHover must rest on THIS and not on a plain
            Transparent. -->
            <Color x:Key="SurfaceHoverGhostColor">#00F0F0F3</Color>
            <!-- Opaque "destructive action" hover fill. The danger RED itself is deliberately not a
            token (see the roadmap's Фаза 4.7 exclusion list) - this is a neutral SURFACE tier that
            happens to be tinted by it, which is this file's remit, and it has to exist as a token
            because it needs a different value per theme. Opaque rather than the translucent
            #1FDC3C3C the danger buttons used to fade to, so the transition off an opaque resting
            fill moves hue only. -->
            <Color x:Key="SurfaceDangerHoverColor">#FFF9E4E4</Color>
            <Color x:Key="ControlTrackOffColor">#FFD5D5DA</Color>
            <Color x:Key="ControlThumbColor">#FFFFFFFF</Color>

            <!-- Borders -->
            <Color x:Key="BorderColor">#FFE2E4E9</Color>
            <Color x:Key="BorderSubtleColor">#FFDFE1E6</Color>
            <Color x:Key="BorderStrongColor">#FFC9CCD3</Color>
            <Color x:Key="BorderDividerColor">#FFD7D7DD</Color>
            <Color x:Key="BorderWindowColor">#FF9E9E9E</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#FF2C2E33</Color>
            <Color x:Key="TextSecondaryColor">#FF3B3B40</Color>
            <Color x:Key="TextMutedColor">#FF5A5D66</Color>
            <Color x:Key="TextSubtleColor">#FF8A8A8A</Color>
            <Color x:Key="TextFaintColor">#FF9A9EA6</Color>
            <Color x:Key="TextGlyphMutedColor">#FFA8A8B0</Color>
            <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!-- Surfaces -->
            <!-- Literal: mockup's pageBg. -->
            <Color x:Key="AppBackgroundColor">#FF1B1D21</Color>
            <!-- Literal: mockup's cardBg. -->
            <Color x:Key="SurfaceColor">#FF24262B</Color>
            <!-- Not a direct mockup role (no app-shell nav sidebar in a single-screen mockup) -
            reused the mockup's wheelBg (#17181B), which sits in exactly the "slightly darker than
            AppBackground" relationship the nav sidebar has to the page in Light. -->
            <Color x:Key="SurfaceMutedColor">#FF17181B</Color>
            <!-- Literal: mockup's tabsWrap background (dark ? '#1e2024' : ...), used for the same
            soft-panel-fill role as CCWheelWrap/CCTabsWrap/input-and-button resting backgrounds. -->
            <Color x:Key="SurfaceSoftColor">#FF1E2024</Color>
            <!-- Literal: mockup's hoverRowBg, matching (within ~2 hex units) its own tab-hover and
            discard-hover literals too - genuinely one tier in the mockup's own dark palette. -->
            <Color x:Key="SurfaceHoverColor">#FF2A2D32</Color>
            <!-- Literal: mockup's inputBg. -->
            <Color x:Key="SurfaceInputColor">#FF1A1C20</Color>
            <!-- Not a direct mockup role (Skin Changer's row list isn't part of this mockup) -
            interpolated between SurfaceColor and SurfaceHoverColor. -->
            <Color x:Key="SurfaceRowColor">#FF292B30</Color>
            <!-- Not a direct mockup role - interpolated one step past SurfaceHoverColor, same
            "row hover reads a bit stronger than a plain ghost-button hover" relationship Light has. -->
            <Color x:Key="SurfaceRowHoverColor">#FF32353B</Color>
            <!-- Not a direct mockup role (no loading-skeleton state in the mockup) - interpolated
            between SurfaceColor and BorderColor. -->
            <Color x:Key="SurfaceSkeletonColor">#FF2E3036</Color>
            <!-- Literal: mockup's badgeBg - noticeably lighter than SurfaceSoftColor in dark (unlike
            Light, where the two were close enough to fold together); see file header. -->
            <Color x:Key="SurfaceBadgeColor">#FF2F3238</Color>
            <!-- Literal: mockup's selected-tab background (dark ? '#33363c' : ...) - a distinctly
            lighter "elevated" surface in dark mode rather than reusing plain SurfaceColor the way
            Light's selected tab does (its own background is just white, same as any card); see
            file header. -->
            <Color x:Key="SurfaceElevatedColor">#FF33363C</Color>
            <!-- See Light's own comment - zero-alpha SurfaceHoverColor, dark value. -->
            <Color x:Key="SurfaceHoverGhostColor">#002A2D32</Color>
            <!-- See Light's own comment. Dark-side value: the same danger hue laid over the dark
            card surface rather than the light one, so it reads as a red-tinted chip in both. -->
            <Color x:Key="SurfaceDangerHoverColor">#FF3A2529</Color>
            <!-- Not a direct mockup role (no toggle switches in the mockup) - a mid-gray with enough
            separation from both SurfaceColor and BorderColor to read as an "off" track. -->
            <Color x:Key="ControlTrackOffColor">#FF40434A</Color>
            <!-- Not a direct mockup role - kept near-white (softened slightly off pure white to cut
            glare against a dark track), matching the common OS convention of an always-light switch
            thumb regardless of app theme. -->
            <Color x:Key="ControlThumbColor">#FFECEDEF</Color>

            <!-- Borders -->
            <!-- Literal: mockup's cardBorder. -->
            <Color x:Key="BorderColor">#FF34373D</Color>
            <!-- Literal: mockup's inputBorder. -->
            <Color x:Key="BorderSubtleColor">#FF3A3D44</Color>
            <!-- Not a direct mockup role (no input/button :hover border state shown) - lightened
            further than BorderColor/BorderSubtleColor for the higher contrast a dark theme's
            "strong" border tier needs (the reverse direction of Light, where "strong" goes darker). -->
            <Color x:Key="BorderStrongColor">#FF4A4E56</Color>
            <!-- Not a direct mockup role - kept close to BorderColor, same near-duplicate
            relationship the two have in Light. -->
            <Color x:Key="BorderDividerColor">#FF3C3F46</Color>
            <!-- Not a direct mockup role (no app shell in the mockup) - lightened well past
            BorderColor so the outermost window frame stays visible against a dark desktop, the
            same purpose Light's noticeably-darker-than-BorderColor #FF9E9E9E serves there. -->
            <Color x:Key="BorderWindowColor">#FF55585F</Color>

            <!-- Text -->
            <!-- Literal: mockup's text. -->
            <Color x:Key="TextPrimaryColor">#FFE8E9EC</Color>
            <!-- Not a direct mockup role - interpolated between TextPrimaryColor and TextMutedColor. -->
            <Color x:Key="TextSecondaryColor">#FFC4C6CB</Color>
            <!-- Literal: mockup's textMuted. -->
            <Color x:Key="TextMutedColor">#FF9297A1</Color>
            <!-- Not a direct mockup role - interpolated between TextMutedColor and TextFaintColor. -->
            <Color x:Key="TextSubtleColor">#FF7D8088</Color>
            <!-- Literal: mockup's textFaint. -->
            <Color x:Key="TextFaintColor">#FF6C7078</Color>
            <!-- Not a direct mockup role (no stroke-icon rows in the mockup) - darker than
            TextFaintColor, mirroring Light where this is the single weakest text-ish tier. -->
            <Color x:Key="TextGlyphMutedColor">#FF5C5F66</Color>
            <!-- Literal: mockup's buttonText - a near-white with a faint cool tint rather than
            pure white, for readability specifically against the richer AccentButtonGradientBrush. -->
            <Color x:Key="TextOnAccentColor">#FFF2FDFB</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Derived brushes - Setters/attributes reference these, never the Color keys directly
    (same convention as AccentColors.axaml). Color property is bound via DynamicResource so
    each brush re-resolves when the active ThemeDictionaries variant changes. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{DynamicResource SurfaceMutedColor}"/>
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{DynamicResource SurfaceSoftColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{DynamicResource SurfaceInputColor}"/>
    <SolidColorBrush x:Key="SurfaceRowBrush" Color="{DynamicResource SurfaceRowColor}"/>
    <SolidColorBrush x:Key="SurfaceRowHoverBrush" Color="{DynamicResource SurfaceRowHoverColor}"/>
    <SolidColorBrush x:Key="SurfaceSkeletonBrush" Color="{DynamicResource SurfaceSkeletonColor}"/>
    <SolidColorBrush x:Key="SurfaceBadgeBrush" Color="{DynamicResource SurfaceBadgeColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{DynamicResource SurfaceElevatedColor}"/>
    <!-- Resting Background for any control that fades IN to SurfaceHoverBrush (2026-08-13). The
    neutral counterpart to AccentColors.axaml's AccentGhostBrush, and it exists because of the same
    BrushTransition behaviour: a transition interpolates the R, G, B and A channels of the two
    brushes INDEPENDENTLY, so it only looks right when one of the two is held still. Resting on a
    literal Transparent (#00000000) moves both - RGB ramps up from black while alpha ramps up from
    zero - and the control visibly passes through a dark smudge on its way to the hover colour
    (user-reported 2026-08-13: buttons "blinking" through several colours on hover, across several
    modules). Resting on the hover colour's own RGB at zero alpha is invisible at rest, exactly like
    Transparent, but leaves alpha as the only channel that moves.
    The rule this file and AccentColors.axaml both follow: a transition may move hue (both endpoints
    opaque) or alpha (both endpoints the same RGB), never both. -->
    <SolidColorBrush x:Key="SurfaceHoverGhostBrush" Color="{DynamicResource SurfaceHoverGhostColor}"/>
    <SolidColorBrush x:Key="SurfaceDangerHoverBrush" Color="{DynamicResource SurfaceDangerHoverColor}"/>
    <SolidColorBrush x:Key="ControlTrackOffBrush" Color="{DynamicResource ControlTrackOffColor}"/>
    <SolidColorBrush x:Key="ControlThumbBrush" Color="{DynamicResource ControlThumbColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="BorderDividerBrush" Color="{DynamicResource BorderDividerColor}"/>
    <SolidColorBrush x:Key="BorderWindowBrush" Color="{DynamicResource BorderWindowColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{DynamicResource TextSubtleColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{DynamicResource TextFaintColor}"/>
    <SolidColorBrush x:Key="TextGlyphMutedBrush" Color="{DynamicResource TextGlyphMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColor}"/>

    <!-- Deliberately NOT theme-variant (flat, always the same value regardless of Light/Dark):
    - Skin Changer's screenshot-tile placeholder gradient (Border.SCScreenshotItem) - a media/photo
      placeholder reads as "dark backdrop for an image" in any app theme, same convention as
      Views/ImageViewWindow.axaml's fixed Background="Black".
    - Tweaker console (Border.TWConsole family) - already a dark terminal-style panel even in the
      app's light theme (see roadmap Фаза 4.5 notes); whether it gets its own darker Dark-mode
      variant is an open decision noted in the roadmap (Фаза 4.7), not resolved by this pass. Kept
      as its own flat tokens so that decision has a single, obvious place to land later instead of
      requiring another literal-hunting pass through TweakerStyles.axaml. -->
    <Color x:Key="MediaGradientTopColor">#FF26262E</Color>
    <Color x:Key="MediaGradientBottomColor">#FF101014</Color>
    <Color x:Key="ConsoleBackgroundColor">#FF1E1E24</Color>
    <Color x:Key="ConsoleTextColor">#FFD8D8E0</Color>
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="{StaticResource ConsoleBackgroundColor}"/>
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleTextColor}"/>

</ResourceDictionary>
