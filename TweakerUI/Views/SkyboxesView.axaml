<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TweakerUI.ViewModels"
             xmlns:models="clr-namespace:TweakerUI.Models"
             xmlns:views="clr-namespace:TweakerUI.Views"
             xmlns:skies="clr-namespace:TweakerCore.Skyboxes;assembly=TweakerCore"
             x:Class="TweakerUI.Views.SkyboxesView"
             x:DataType="vm:SkyboxesViewModel">

    <Border Background="{DynamicResource AppBackgroundBrush}">
        <TabControl Margin="20,12,20,20" SelectedIndex="{Binding Page, Mode=TwoWay}" Classes="SKPages">
            <TabItem Header="Game" Classes="SKPage">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                    <Border Grid.Row="0" Classes="Card Tinted" Margin="0,0,0,14"
                            IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="Notice" Text="{Binding Notice}"/>
                    </Border>

                    <Border Grid.Row="1" Classes="Card Roomy" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Replace the sky sphere" Classes="CardTitle" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              IsEnabled="{Binding CanControl}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Classes="RowDescription" Text="{Binding ActiveText}"/>
                            <TextBlock Classes="Problem" Text="{Binding LoadProblem}"
                                       IsVisible="{Binding LoadProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Classes="Card Roomy">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <TextBlock Text="Installed skies" Classes="CardTitle" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="ActionButton" Content="Open folder" Command="{Binding OpenGameFolderCommand}"/>
                                    <Button Classes="ActionButton" Content="Refresh" Command="{Binding RefreshCommand}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Classes="EmptyState" TextWrapping="Wrap" MaxWidth="500" Text="{Binding EmptyText}"
                                       IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ListBox Grid.Row="1" Classes="RowList" ItemsSource="{Binding Skies}"
                                     SelectedItem="{Binding SelectedSky, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:SkyRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,9">
                                            <TextBlock Text="●" Classes="SKActive" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Classes.Selected="{Binding IsActive}"/>
                                            <StackPanel Grid.Column="1" IsEnabled="{Binding $parent[UserControl].((vm:SkyboxesViewModel)DataContext).CanControl}">
                                                <TextBlock Classes="RowTitle" Text="{Binding Title}"/>
                                                <TextBlock Classes="RowSubtitle" Text="{Binding Description}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Button Classes="IconButton" IsVisible="{Binding CanReveal}" ToolTip.Tip="Show in Explorer"
                                                        Command="{Binding $parent[UserControl].((vm:SkyboxesViewModel)DataContext).RevealSkyCommand}" CommandParameter="{Binding}">
                                                    <Path Classes="ToolIcon" Data="{StaticResource IconFolder}"/>
                                                </Button>
                                                <Button Classes="IconButton Danger" IsVisible="{Binding CanDelete}" ToolTip.Tip="Delete sky"
                                                        Command="{Binding $parent[UserControl].((vm:SkyboxesViewModel)DataContext).DeleteSkyCommand}" CommandParameter="{Binding}">
                                                    <Path Classes="ToolIcon" Data="{StaticResource IconDelete}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Projects" Classes="SKPage">
                <Grid ColumnDefinitions="280,14,*" Margin="0,12,0,0">
                    <Grid RowDefinitions="*,14,Auto">
                        <Border Classes="Card Roomy">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <TextBlock Text="Projects" Classes="CardTitle" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="IconButton" Command="{Binding StartCreateCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="New project">
                                            <Path Classes="ToolIcon" Data="{StaticResource IconAdd}"/>
                                        </Button>
                                        <Button Classes="IconButton" Command="{Binding OpenExistingCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="Open a folder as a project">
                                            <Path Classes="ToolIcon" Data="{StaticResource IconFolder}"/>
                                        </Button>
                                        <Button Classes="IconButton" Command="{Binding RefreshProjectsCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="Read projects again">
                                            <Path Classes="ToolIcon" Data="{StaticResource IconRefresh}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ListBox Grid.Row="1" Classes="RowList" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:SkyProjectRowViewModel">
                                            <StackPanel Classes="ProjectRow">
                                                <TextBlock Classes="RowTitle" Text="{Binding Title}"/>
                                                <TextBlock Classes="RowSubtitle" Text="{Binding PackageFileName}"/>
                                                <TextBlock Classes="Problem" Text="{Binding Problem}"
                                                           IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Classes="Card Roomy" MaxHeight="270">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <views:EditorPickerView DataContext="{Binding Editor}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Classes="Card Roomy">
                        <Panel>
                            <TextBlock Classes="EmptyState" TextWrapping="Wrap" MaxWidth="320" IsVisible="{Binding ShowNoProject}"
                                       Text="Create a sky project with +, or open a folder with Config.json."/>

                            <Grid IsVisible="{Binding ShowForm}" RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <TextBlock Classes="CardTitle" Text="New sky project" IsVisible="{Binding IsCreating}" VerticalAlignment="Center"/>
                                    <TextBlock Classes="CardTitle" Text="Edit manifest" IsVisible="{Binding IsEditing}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !Busy}">
                                        <Button Classes="ActionButton" Content="Create" IsVisible="{Binding IsCreating}" Command="{Binding CreateCommand}"/>
                                        <Button Classes="ActionButton" Content="Save" IsVisible="{Binding IsEditing}" Command="{Binding SaveEditCommand}"/>
                                        <Button Classes="ActionButton" Content="Cancel" Command="{Binding CancelFormCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="4" IsEnabled="{Binding !Busy}">
                                        <TextBlock Classes="FieldLabel" Text="Name"/>
                                        <TextBox Classes="TextField" Text="{Binding ProjectName, Mode=TwoWay}" PlaceholderText="My Sky"/>
                                        <TextBlock Classes="Problem" Text="{Binding NameProblem}" IsVisible="{Binding NameProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="Hint" Text="{Binding PackageHint}"/>
                                        <TextBlock Classes="Warning" Text="{Binding RenameWarning}" IsVisible="{Binding RenameWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="FieldLabel" Text="Author (optional)" Margin="2,12,0,4"/>
                                        <TextBox Classes="TextField" Text="{Binding ProjectAuthor, Mode=TwoWay}"/>
                                        <TextBlock Classes="Problem" Text="{Binding AuthorProblem}" IsVisible="{Binding AuthorProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                        <StackPanel IsVisible="{Binding IsEditing}" Spacing="4" Margin="0,12,0,0">
                                            <TextBlock Classes="FieldLabel" Text="Version"/>
                                            <TextBox Classes="TextField" Text="{Binding ProjectVersion, Mode=TwoWay}"/>
                                            <TextBlock Classes="Problem" Text="{Binding VersionProblem}" IsVisible="{Binding VersionProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Classes="Hint" Text="The generation of the sky's saved controls. Increasing it resets players' saved values; it is not a release number."/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding IsCreating}" Spacing="4" Margin="0,12,0,0">
                                            <TextBlock Classes="FieldLabel" Text="Start from"/>
                                            <ListBox Classes="RowList" ItemsSource="{Binding Templates}" SelectedItem="{Binding Template, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="skies:SkyTemplate">
                                                        <StackPanel Classes="ChoiceRow">
                                                            <TextBlock Classes="RowTitle" Text="{Binding Title}"/>
                                                            <TextBlock Classes="RowSubtitle" Text="{Binding Hint}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Classes="Hint" Text="Created in DevTools\SkySources next to Tweaker."/>
                                        </StackPanel>
                                        <TextBlock Classes="Problem" Text="{Binding FormProblem}" IsVisible="{Binding FormProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid IsVisible="{Binding ShowDetails}" RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <TextBlock Classes="CardTitle" Text="{Binding SelectedProject.Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding !Busy}">
                                        <Button Classes="IconButton" Command="{Binding StartEditCommand}" IsEnabled="{Binding !SelectedProject.IsMissing}" ToolTip.Tip="Edit name, author and version">
                                            <Path Classes="ToolIcon" Data="{StaticResource IconRename}"/>
                                        </Button>
                                        <Button Classes="IconButton" Command="{Binding OpenProjectFolderCommand}" IsEnabled="{Binding !SelectedProject.IsMissing}" ToolTip.Tip="Open project folder">
                                            <Path Classes="ToolIcon" Data="{StaticResource IconFolder}"/>
                                        </Button>
                                        <Button Classes="IconButton Danger" Command="{Binding DeleteProjectCommand}" IsEnabled="{Binding !SelectedProject.IsMissing}" ToolTip.Tip="Delete project">
                                            <Path Classes="ToolIcon" Data="{StaticResource IconDelete}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="12">
                                        <StackPanel>
                                            <TextBlock Classes="RowDescription" Text="{Binding SelectedProject.Details}"/>
                                            <TextBlock Classes="RowPath" Text="{Binding SelectedProject.Root}" ToolTip.Tip="{Binding SelectedProject.Root}"/>
                                            <TextBlock Classes="Problem" Text="{Binding SelectedProject.Problem}" IsVisible="{Binding SelectedProject.Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <WrapPanel IsEnabled="{Binding !Busy}">
                                            <Button Classes="ActionButton SKAction" Content="Install" Command="{Binding InstallCommand}" IsEnabled="{Binding !SelectedProject.IsMissing}"/>
                                            <Button Classes="ActionButton SKAction" Content="Install and use" Command="{Binding InstallAndUseCommand}" IsEnabled="{Binding !SelectedProject.IsMissing}"/>
                                            <Button Classes="ActionButton SKAction" Content="Pack to file…" Command="{Binding ExportCommand}" IsEnabled="{Binding !SelectedProject.IsMissing}"/>
                                        </WrapPanel>
                                        <Border Classes="ToggleRow" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ToggleButton Classes="Switch" IsChecked="{Binding InstallOnSave, Mode=TwoWay}" IsEnabled="{Binding !SelectedProject.IsMissing}"/>
                                                <TextBlock Classes="ToggleLabel" Text="Install on save" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="Hint" Text="Each save packs and installs this project. If it is active in the connected game, the game loads the new version."/>
                                        <TextBlock Classes="RowDescription" Text="{Binding SelectedProject.Result}" IsVisible="{Binding SelectedProject.Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="RowDescription" Text="{Binding ProjectGameStatus}" IsVisible="{Binding ProjectGameStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedProject.Problems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="skies:SkyProblem">
                                                    <TextBlock Classes="Problem" Classes.Warning="{Binding !IsError}" Text="{Binding}" DoubleTapped="OnProblemDoubleTapped"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="ActionButton" Content="{Binding Editor.OpenInEditorText}" Command="{Binding OpenInEditorCommand}" IsEnabled="{Binding !SelectedProject.IsMissing}" HorizontalAlignment="Left"/>
                                        <Button Classes="ActionButton" Content="Forget project" Command="{Binding ForgetProjectCommand}" IsVisible="{Binding SelectedProject.CanForget}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
