<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TweakerUI.Views.Dialogs"
        x:Class="TweakerUI.Views.Dialogs.TweakerDialogWindow"
        x:DataType="local:TweakerDialogWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid>
        <Border Background="Black" Opacity="0.45"/>

        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10"
                Padding="24"
                MinWidth="300"
                MaxWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 4 24 0 #40000000">
            <StackPanel Spacing="20">
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center"/>
                <!-- Populated from code-behind: the choice list is per-dialog (two buttons for the
                     OK/Cancel pair, three for the plugin flows), and building it here would mean an
                     ItemsControl reaching back out to the Window for its click command. -->
                <WrapPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
