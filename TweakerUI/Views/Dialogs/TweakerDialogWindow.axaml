<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TweakerUI.Views.Dialogs"
        x:Class="TweakerUI.Views.Dialogs.TweakerDialogWindow"
        x:DataType="local:TweakerDialogWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid RowDefinitions="2*,Auto,2*">
        <Border Grid.Row="0" Background="Black" Opacity="0.45"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="24"
                MinWidth="300"
                MaxWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 4 24 0 #40000000">
            <StackPanel Spacing="20">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Content="OK" Click="OnOkClick" IsVisible="{Binding ShowOk}" MinWidth="80"/>
                    <Button Content="Cancel" Click="OnCancelClick" IsVisible="{Binding ShowCancel}" MinWidth="80"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="Black" Opacity="0.45"/>
    </Grid>
</Window>
