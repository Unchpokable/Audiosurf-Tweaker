<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TweakerUI.ViewModels"
        xmlns:core="clr-namespace:TweakerUI.Core"
        xmlns:conv="clr-namespace:TweakerUI.Core.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="TweakerUI.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="avares://TweakerUI/Assets/TweakerIcon.ico"
        Title="Audiosurf Tweaker"
        Width="1200" Height="700"
        MinWidth="1000" MinHeight="600"
        WindowDecorations="None"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <viewModels:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <conv:CountGreaterThanZeroConverter x:Key="CountGreaterThanZeroConverter"/>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderWindowBrush}" BorderThickness="1">
        <Grid RowDefinitions="35,*,Auto">

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Image Source="avares://TweakerUI/Assets/TweakerIcon.ico" Width="18" Height="18"/>
                        <TextBlock Text="Audiosurf Tweaker" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Classes="TitleBarButton" Content="&#8212;" Click="OnMinimizeClick" ToolTip.Tip="Minimize"/>
                        <Button Classes="TitleBarButton" Content="&#9633;" Click="OnMaximizeClick" ToolTip.Tip="Maximize"/>
                        <Button Classes="TitleBarButton TitleBarButtonClose" Content="&#10005;" Click="OnCloseClick" ToolTip.Tip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="260,*">

                <!-- Navigation -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <StackPanel Grid.Row="0" Margin="16,16,16,8">
                            <TextBlock Text="Menu" FontSize="20" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <RadioButton Classes="NavItem" Content="Skin Changer" GroupName="Nav" IsChecked="True" Command="{Binding ShowSkinChangerCommand}"/>
                            <RadioButton Classes="NavItem" Content="Colors Configurator" GroupName="Nav" Command="{Binding ShowColorsCommand}"/>
                            <RadioButton Classes="NavItem" Content="Command and Control" GroupName="Nav" Command="{Binding ShowTweakerCommand}"/>
                            <RadioButton Classes="NavItem" Content="Quick Player" GroupName="Nav" Command="{Binding ShowQuickPlayerCommand}"/>
                            <RadioButton Classes="NavItem" Content="Settings" GroupName="Nav" Command="{Binding ShowSettingsCommand}"/>
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0" Margin="16,0,16,16" Padding="0,14,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding AudiosurfStatusBrush}" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AudiosurfStatusMessage}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" Classes="IconResetButton" Command="{Binding ResetBridgeCommand}"
                                        ToolTip.Tip="Reinitialize the bridge and try to register with the game again">
                                    <Path Data="{StaticResource IconReset}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Active module -->
                <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>

                <!-- Resize grip -->
                <Panel Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizeGripPointerPressed"/>
            </Grid>

            <!-- Status bar - app-wide, multi-source (TweakerUI.Core.StatusService). Collapsed entirely
                 when nothing is active, same "quiet by default" principle as the service itself. -->
            <Border Grid.Row="2" Classes="SBBar" IsVisible="{Binding ActiveStatuses.Count, Converter={StaticResource CountGreaterThanZeroConverter}}">
                <ItemsControl ItemsSource="{Binding ActiveStatuses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:StatusEntry">
                            <Border Classes="SBChip"
                                    Classes.Working="{Binding Token, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Working}"
                                    Classes.DiskProcess="{Binding Token, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DiskProcess}"
                                    Classes.Network="{Binding Token, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Network}"
                                    Classes.Playing="{Binding Token, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Playing}"
                                    Classes.Warning="{Binding Token, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Warning}"
                                    Classes.Error="{Binding Token, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Error}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="SBChipIcon"/>
                                    <TextBlock Classes="SBChipSource" Text="{Binding Source}"/>
                                    <TextBlock Classes="SBChipMessage" Text="{Binding Message}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</Window>
