<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TweakerUI.ViewModels"
             x:Class="TweakerUI.Views.SettingView"
             x:DataType="vm:SettingViewModel">

    <!-- No mockup for this tab either - single scrollable page of card sections, same spirit as
    TweakerView, instead of the donor's WPF TabControl (Paths / Skin Changer / Watcher / UI). -->
    <Border Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- Appearance -->
                <Border Classes="Card Roomy">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Appearance" Classes="CardTitle" Margin="0,0,0,8"/>

                        <Border Classes="ToggleRow"
                                ToolTip.Tip="Switch the app's color theme - takes effect immediately, no restart needed">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Dark theme" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Paths -->
                <Border Classes="Card Roomy">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Paths" Classes="CardTitle"/>
                        <StackPanel>
                            <TextBlock Text="Path to Audiosurf textures" Classes="STFieldLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Classes="STPathBox" Text="{Binding TexturesFolderPath}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Classes="STBrowseButton" Content="Browse…" Command="{Binding BrowseTexturesPathCommand}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Additional skins folder" Classes="STFieldLabel"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Classes="STPathBox" Text="{Binding AdditionalSkinsFolderPath}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Classes="STBrowseButton" Content="Browse…" Command="{Binding BrowseSkinsPathCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Skin Changer -->
                <Border Classes="Card Roomy">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Skin Changer" Classes="CardTitle" Margin="0,0,0,8"/>

                        <Border Classes="ToggleRow"
                                ToolTip.Tip="Force the game to reload textures after skin installation - no need to restart the track in-game to see changes">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Hot reload" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsHotReload, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="ToggleRow"
                                ToolTip.Tip="Compare checksums of the game's textures folder at startup, to catch unsaved changes before they're overwritten">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Control game's textures folder content" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsShouldCheckTextures, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="ToggleRow STNested" IsEnabled="{Binding IsShouldCheckTextures}"
                                ToolTip.Tip="Refuse to install a skin while the game's textures folder content is unsaved">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Safety installation" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsShouldUseSafetyInstallation, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="ToggleRow"
                                ToolTip.Tip="Keep every skin's screenshots in memory: selecting a skin is instant, and hovering a skin shows its preview. Costs about 1.6 MB of memory per screenshot - around 100 MB for twenty skins">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Fast preview" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsFastPreview, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- In-game plugin -->
                <Border Classes="Card Roomy">
                    <StackPanel Spacing="2">
                        <TextBlock Text="In-game plugin" Classes="CardTitle" Margin="0,0,0,2"/>
                        <TextBlock Classes="STToggleHint" Margin="2,0,0,8"
                                   Text="Puts TweakerPlugin into the game, where it draws the overlay, replaces the skybox and runs scripts. The game loads it by itself at startup - Tweaker does not have to be running."/>

                        <Border Classes="ToggleRow"
                                ToolTip.Tip="Copies the plugin into the game's engine\channels folder, or takes it back out. Your skyboxes, scripts and configs are never removed">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="[Experimental] Install the plugin into Audiosurf" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsPluginInstalled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="ToggleRow STNested" IsEnabled="{Binding IsPluginInstalled}"
                                ToolTip.Tip="Off disconnects the overlay from Tweaker right away: skyboxes and scripts keep running in the game, but the overlay's Skins, Tweaks and Player tabs go offline">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Connect the in-game overlay to Tweaker" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsOverlaySyncEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <TextBlock Classes="STToggleHint" Margin="2,8,0,0" TextWrapping="Wrap" Text="{Binding PluginStatus}"/>
                    </StackPanel>
                </Border>

                <!-- Textures Watcher -->
                <Border Classes="Card Roomy">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Textures Watcher" Classes="CardTitle" Margin="0,0,0,2"/>
                        <TextBlock Classes="STToggleHint" Margin="2,0,0,8"
                                   Text="Tracks the game's textures folder and notifies the game about changes in real time. Only active while Audiosurf is connected."/>

                        <Border Classes="ToggleRow"
                                ToolTip.Tip="Watch the game's textures folder and notify the game about changes in real time">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Enabled" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsWatcherActive, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="ToggleRow STNested" IsEnabled="{Binding IsWatcherActive}"
                                ToolTip.Tip="Store every change to the textures folder in a temporary skin file">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Store textures in temp file" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsShouldStoreTextures, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="ToggleRow STNested" IsEnabled="{Binding IsWatcherActive}"
                                ToolTip.Tip="Use a custom temp file instead of the default Storage/temp.tasp">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Override temp file" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsTempFileOverrided, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Nested IsEnabled: needs both the watcher on AND the override toggled - a
                        plain single binding can't express the AND, so this relies on Avalonia's normal
                        IsEnabled inheritance (outer bound to IsWatcherActive, inner to IsTempFileOverrided). -->
                        <Border IsEnabled="{Binding IsWatcherActive}">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="30,4,0,0" IsEnabled="{Binding IsTempFileOverrided}">
                                <TextBox Grid.Column="0" Classes="STPathBox" Text="{Binding WatcherTempFile}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Classes="STBrowseButton" Content="Select…" Command="{Binding SelectTempFileCommand}"/>
                                <Button Grid.Column="2" Classes="STBrowseButton" Content="Duplicate" Command="{Binding DuplicateTempFileCommand}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Classes="Card Roomy">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Notifications" Classes="CardTitle" Margin="0,0,0,8"/>

                        <Border Classes="ToggleRow"
                                ToolTip.Tip="Send Windows notifications after actions complete, instead of the app's own colored popups">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Use UWP notifications" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsUWPNotificationsAllowed, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Classes="ToggleRow STNested" IsEnabled="{Binding IsUWPNotificationsAllowed}"
                                ToolTip.Tip="Show UWP notifications but suppress the system notification sound">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Mute UWP notifications" Classes="ToggleLabel" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding IsUWPNotificationSilent, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
