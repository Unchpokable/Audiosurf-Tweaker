<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TweakerUI.App"
             xmlns:tweakerUi="clr-namespace:TweakerUI"
             RequestedThemeVariant="Light">
    <!-- "Light" here is only the design-time/pre-config-load fallback (e.g. previewer, or the brief
         window before MainWindowViewModel's constructor finishes loading SettingsProvider). The real,
         user-facing value is set in code - App.axaml.cs.OnFrameworkInitializationCompleted calls
         ThemeService.Apply(SettingsProvider.IsDarkTheme) once config is loaded, and the Settings
         "Appearance" toggle (SettingViewModel.IsDarkTheme) calls the same method live, no restart
         needed - see ThemeService.cs. Deliberately NOT "Default" (follow the OS) - this app doesn't
         want to switch themes out from under the user without them choosing to in Settings. -->

    <Application.DataTemplates>
        <tweakerUi:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://TweakerUI/Themes/NeutralColors.axaml"/>
                <ResourceInclude Source="avares://TweakerUI/Themes/AccentColors.axaml"/>
                <ResourceInclude Source="avares://TweakerUI/Themes/SharedControlTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TweakerUI/Themes/ScrollBarStyles.axaml"/>
        <StyleInclude Source="avares://TweakerUI/Themes/Styles.axaml"/>
        <StyleInclude Source="avares://TweakerUI/Themes/SkinChangerStyles.axaml"/>
        <StyleInclude Source="avares://TweakerUI/Themes/TweakerStyles.axaml"/>
        <StyleInclude Source="avares://TweakerUI/Themes/SettingsStyles.axaml"/>
    </Application.Styles>
</Application>