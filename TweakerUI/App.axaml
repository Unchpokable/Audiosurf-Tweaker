<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TweakerUI.App"
             xmlns:tweakerUi="clr-namespace:TweakerUI"
             RequestedThemeVariant="Light">
    <!-- Pinned to Light: the custom chrome in Themes/Styles.axaml hardcodes a light palette (matching
         the old WPF app, which never had a dark mode either) rather than theme-resource colors, so
         following the system's dark variant would only mismatch unstyled FluentTheme control parts. -->

    <Application.DataTemplates>
        <tweakerUi:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TweakerUI/Themes/Styles.axaml"/>
    </Application.Styles>
</Application>