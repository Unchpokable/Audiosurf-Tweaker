<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Picked up automatically by the SDK-style build (Microsoft.NET.Sdk copies/renames a project-root
    "App.config" to "<TargetFileName>.config" at build time - no explicit csproj wiring needed) and
    read via ConfigurationManager.OpenExeConfiguration(ExePath) in Core/ConfigurationManager.cs.
    Keys mirror what InitializeEnvironment()/RewriteSettings() read and write; keep both in sync if
    a setting is added or removed here.
  -->
  <appSettings>
    <add key="FirstRun" value="true" />
    <add key="TexturesPath" value="None" />
    <add key="AddSkinsPath" value="None" />
    <add key="HotReload" value="true" />
    <add key="DCSActive" value="true" />
    <add key="SafeInstall" value="false" />
    <add key="UseFastPreview" value="false" />
    <add key="WatcherEnabled" value="false" />
    <add key="WatcherTempFile" value="Storage/temp.tasp" />
    <add key="WatcherShouldStoreTextures" value="false" />
    <add key="WatcherTempFileOverrided" value="false" />
    <add key="UWPNotificationsAllowed" value="false" />
    <add key="UWPNotificationSilent" value="true" />
    <add key="DarkTheme" value="false" />
    <add key="EnableInGameOverlay" value="false" />
  </appSettings>
</configuration>
