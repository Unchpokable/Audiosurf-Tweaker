<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Needs a Windows SDK-versioned TFM (not bare net10.0-windows) for the WinRT toast
         notification projection (Microsoft.Toolkit.Uwp.Notifications' ToastContentBuilder.Show()). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SkinChangerRestyle</RootNamespace>
    <AssemblyName>audiosurftweaker</AssemblyName>
    <ApplicationIcon>NewTweakerIcon.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- System.Drawing.Common is Windows-only on modern .NET; the SkiaSharp swap is phase 3b. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\AstroSpace-eZ2Bg.ttf" />
    <Resource Include="Fonts\Atmospheric-rg4aL.ttf" />
    <Resource Include="Fonts\ExoSoft-Light.ttf" />
    <Resource Include="Fonts\ExoSoft-Regular.ttf" />
    <Resource Include="Resources\MissingTextureFullHD.png" />
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\edit.svg" />
    <Resource Include="Resources\editondisk.svg" />
    <Resource Include="Resources\export.svg" />
    <Resource Include="Resources\install.svg" />
    <Resource Include="Tweaker_Icon_1.ico" />
    <Resource Include="NewTweakerIcon.ico" />
    <SplashScreen Include="Resources\TweakerSplashScreenV2.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudiosurfInterface\AudiosurfInterface.csproj" />
    <ProjectReference Include="..\TweakerCore\TweakerCore.csproj" />
    <ProjectReference Include="..\TweakerScriptsInterpreter\TweakerScriptInterpreter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Gameloop.Vdf" Version="0.6.2" />
    <PackageReference Include="Gameloop.Vdf.JsonConverter" Version="0.2.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1938.49" />
    <PackageReference Include="Notification.Wpf" Version="7.0.0.2" />
    <PackageReference Include="PixiEditor.ColorPicker" Version="3.3.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

</Project>
