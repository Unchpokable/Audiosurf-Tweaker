<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Needs a Windows SDK-versioned TFM (not bare net10.0-windows) for the WinRT toast
         notification projection (Microsoft.Toolkit.Uwp.Notifications' ToastContentBuilder.Show()). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SkinChangerRestyle</RootNamespace>
    <AssemblyName>audiosurftweaker</AssemblyName>
    <ApplicationIcon>NewTweakerIcon.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- System.Drawing.Common is Windows-only on modern .NET; the SkiaSharp swap is phase 3b. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\AstroSpace-eZ2Bg.ttf" />
    <Resource Include="Fonts\Atmospheric-rg4aL.ttf" />
    <Resource Include="Fonts\ExoSoft-Light.ttf" />
    <Resource Include="Fonts\ExoSoft-Regular.ttf" />
    <Resource Include="Resources\MissingTextureFullHD.png" />
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\edit.svg" />
    <Resource Include="Resources\editondisk.svg" />
    <Resource Include="Resources\export.svg" />
    <Resource Include="Resources\install.svg" />
    <Resource Include="Tweaker_Icon_1.ico" />
    <Resource Include="NewTweakerIcon.ico" />
    <SplashScreen Include="Resources\TweakerSplashScreenV2.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudiosurfInterface\AudiosurfInterface.csproj" />
    <ProjectReference Include="..\TweakerCore\TweakerCore.csproj" />
    <ProjectReference Include="..\TweakerScriptsInterpreter\TweakerScriptInterpreter.csproj" />
  </ItemGroup>

  <!--
    Native asbridge.exe (Live IPC subprocess) is built by CMake as a black box - no vcxproj, not in
    the .sln. On Windows a CMake failure fails the whole solution build on purpose; on non-Windows
    the step is skipped entirely (WM_COPYDATA IPC is unimplementable against a Wine-hosted game).
  -->
  <PropertyGroup>
    <AsBridgeSourceDir>$(MSBuildThisFileDirectory)..\ASBridge</AsBridgeSourceDir>
    <AsBridgeBuildDir>$(AsBridgeSourceDir)\build\msbuild</AsBridgeBuildDir>
  </PropertyGroup>

  <Target Name="BuildAsBridge" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="cmake -S &quot;$(AsBridgeSourceDir)&quot; -B &quot;$(AsBridgeBuildDir)&quot;" />
    <Exec Command="cmake --build &quot;$(AsBridgeBuildDir)&quot; --config Release" />
  </Target>

  <Target Name="CopyAsBridge" AfterTargets="BuildAsBridge" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <!-- Single-config generators (Ninja) emit to bin\, multi-config (Visual Studio) to bin\<Config>\. -->
      <AsBridgeExe>$(AsBridgeBuildDir)\bin\asbridge.exe</AsBridgeExe>
      <AsBridgeExe Condition="!Exists('$(AsBridgeExe)')">$(AsBridgeBuildDir)\bin\Release\asbridge.exe</AsBridgeExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(AsBridgeExe)')" Text="asbridge.exe not found after CMake build at $(AsBridgeBuildDir)" />
    <Copy SourceFiles="$(AsBridgeExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Gameloop.Vdf" Version="0.6.2" />
    <PackageReference Include="Gameloop.Vdf.JsonConverter" Version="0.2.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Notification.Wpf" Version="11.0.0" />
    <PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
    <PackageReference Include="SkiaSharp" Version="4.150.0" />
  </ItemGroup>

</Project>
