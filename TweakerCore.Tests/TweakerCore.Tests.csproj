<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TweakerCore\TweakerCore.csproj" />
  </ItemGroup>

  <!--
    The real twllink for TwllinkTests: TweakerCore.Scripting.Twllink is only a client of its command line, and
    a client is best tested against the thing it talks to. Built and copied into twllink\ of the test output
    the same way TweakerUI.csproj puts it into DevTools\Binaries\ (see CopyTwllink there).
  -->
  <ItemGroup>
    <ProjectReference Include="..\TweakerLuaLinker\TweakerLuaLinker.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="TwllinkBuildOutput" />
  </ItemGroup>

  <Target Name="CopyTwllink" AfterTargets="Build">
    <ItemGroup>
      <TwllinkFiles Include="%(TwllinkBuildOutput.RootDir)%(TwllinkBuildOutput.Directory)*" />
    </ItemGroup>
    <Copy SourceFiles="@(TwllinkFiles)" DestinationFolder="$(OutDir)twllink\" SkipUnchangedFiles="true" />
  </Target>

</Project>
