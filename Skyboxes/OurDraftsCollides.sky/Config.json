{
  // Generated from Our Drafts Collides v2.hlsl's @sky block by skyconv.
  // See Docs/Internal/sky-package.md.
  "format": 1,
  "name": "Our Drafts Collides v2",
  "version": 1,
  "shared": {
    // The sky's lights. Every layer binds to these rather than declaring its own, which is what
    // makes the clouds agree with the sky about where the light is coming from.
    //
    // A light is a direction, a colour and an intensity, and any of the three may be left out - a
    // light with no colour is white, one with no intensity is at full strength. Nothing here is
    // specific to a sun: a moon, an aurora or a horizon glow is declared the same way and is bound
    // the same way, and that is the point.
    "lights": [
      {
        "id": "primary",
        "bearing": {
          "label": "Bearing (deg)",
          "default": -14.48,
          "min": -180.0,
          "max": 180.0
        },
        "elevation": {
          "label": "Elevation (deg)",
          "default": 29.00,
          "min": -20.0,
          "max": 70.0
        },
        "color": {
          "label": "Sun colour",
          "default": [
            1.00,
            0.96,
            0.86
          ]
        },
        "intensity": {
          "label": "Sun strength",
          "default": 1.00,
          "min": 0.0,
          "max": 2.0
        }
      },
      {
        "id": "twin",
        // Authored relative to the first: an offset in degrees, which is what a sky with a pair of
        // suns actually wants to type. `lights.twin.direction` resolves the chain and hands out the
        // absolute vector, so nothing binding to it has to know any of this.
        "bearing": {
          "label": "Twin offset (deg)",
          "default": 180.0,
          "min": 0.0,
          "max": 180.0,
          "relative_to": "primary"
        },
        "elevation": {
          "same_as": "primary"
        },
        "color": {
          "label": "Twin colour",
          "default": [
            0.72,
            0.82,
            1.00
          ]
        },
        "intensity": {
          "label": "Twin strength",
          "default": 1.00,
          "min": 0.0,
          "max": 2.0
        }
      },
      {
        // No direction at all - the light the sky itself throws at everything hanging in it. Without
        // one, the unlit side of a cloud is pure black and reads as a hole rather than as a cloud.
        "id": "ambient",
        "kind": "ambient",
        "color": {
          "label": "Ambient colour",
          "default": [
            0.55,
            0.62,
            0.78
          ]
        },
        "intensity": {
          "label": "Ambient level",
          "default": 0.25,
          "min": 0.0,
          "max": 1.0
        }
      }
    ]
  },
  "layers": [
