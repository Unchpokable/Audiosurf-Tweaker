    {
      // The geometry layer: flat quads on a shell, drawn as a second pass over the sky.
      //
      // Its shaders live in this package, next to the sky's own, and are compiled from there while
      // the game runs - "shaders/clouds" names the pair, and the plugin reads "clouds.vs.hlsl" and
      // "clouds.ps.hlsl". Leaving this out falls back to the pair built into the plugin, which draws
      // the same clouds but leaves nobody able to see where they came from.
      "id": "clouds",
      "kind": "sprites",
      "shader": "shaders/clouds",
      // What this layer is lit by, and the whole reason the format exists. It asks for directions
      // and colours; the sky answers from its own `shared.lights`. Neither side knows the other -
      // the sky does not publish anything for the clouds to fetch, and the clouds do not know that
      // a bearing in degrees is how the sky's author prefers to write a direction down.
      "bind": {
        "g_light.xyz": "lights.primary.direction",
        "g_light.w": "lights.ambient.intensity",
        "g_light2.xyz": "lights.twin.direction",
        "g_light2.w": "lights.twin.intensity"
      },
      "params": [
        {
          "group": "Cloud cover",
          "params": [
            // "prop" rather than "var": these decide what is *in* the vertex buffer rather than how
            // it is shaded, so no shader constant could express them. Moving one rebuilds the layer.
            {
              "prop": "count",
              "label": "Sprites",
              "default": 220,
              "min": 0,
              "max": 900
            },
            {
              "prop": "clumps",
              "label": "Clumps",
              "default": 22,
              "min": 1,
              "max": 200
            },
            {
              "prop": "spread",
              "label": "Clump spread (deg)",
              "default": 12.0,
              "min": 0.0,
              "max": 60.0
            },
            {
              "prop": "size",
              "label": "Size (deg)",
              "default": 4.0,
              "min": 0.5,
              "max": 20.0
            }
          ]
        },
        {
          "group": "Cloud shape",
          "params": [
            // 0 puts the clumps on an even lattice, which is uniform but visibly a spiral. 1 lets
            // each wander a full cell off it, which reads as random and cannot leave a bald patch -
            // which is what independent random directions do at these counts.
            {
              "prop": "scatter",
              "label": "Scatter",
              "default": 0.85,
              "min": 0.0,
              "max": 1.0
            },
            // Clouds are not discs. Above 1 each clump takes its own aspect ratio and its own
            // heading, so a bank of them is drawn out along something rather than dabbed in circles.
            {
              "prop": "elongation",
              "label": "Elongation",
              "default": 2.2,
              "min": 1.0,
              "max": 6.0
            },
            // The floor keeps the layer out of the horizon haze the sky shader paints below it - a
            // sprite drawn into that reads as a cut-out pasted over the fog rather than as a cloud
            // behind it. Whole quads clear it, not just their centres.
            {
              "prop": "floor",
              "label": "Floor (deg)",
              "default": 9.0,
              "min": -20.0,
              "max": 60.0
            },
            {
              "prop": "ceiling",
              "label": "Ceiling (deg)",
              "default": 78.0,
              "min": 10.0,
              "max": 90.0
            }
          ]
        },
        {
          // Vertex-stage knobs. They resolve in the vertex shader's own constant table, exactly as
          // the material knobs resolve in the pixel shader's - the manifest names variables and the
          // loader finds them in whichever stage declares them.
          "group": "Cloud motion",
          "params": [
            // The only knob here that accumulates, and it turns the whole layer as one - so a clump
            // stays a clump however long the song runs. Everything below it oscillates.
            {
              "var": "g_motion.x",
              "label": "Drift (deg/s)",
              "default": 0.35,
              "min": -6.0,
              "max": 6.0
            },
            {
              "var": "g_motion.y",
              "label": "Wobble (deg)",
              "default": 0.6,
              "min": 0.0,
              "max": 4.0
            },
            {
              "var": "g_motion.z",
              "label": "Wobble rate",
              "default": 0.05,
              "min": 0.0,
              "max": 0.5
            },
            // Bounded low on purpose: the atlas is a baked image, so this stretches a picture rather
            // than evolving a cloud. A little reads as life, a lot reads as pumping.
            {
              "var": "g_motion.w",
              "label": "Breathe",
              "default": 0.07,
              "min": 0.0,
              "max": 0.35
            },
            {
              "var": "g_motion2.x",
              "label": "Breathe rate",
              "default": 0.08,
              "min": 0.0,
              "max": 0.6
            },
            // The lighting is computed in the unsheared basis, so past a small lean the lumps stop
            // agreeing with the silhouette they sit on.
            {
              "var": "g_motion2.y",
              "label": "Shear",
              "default": 0.05,
              "min": 0.0,
              "max": 0.4
            },
            {
              "var": "g_motion2.z",
              "label": "Shear rate",
              "default": 0.06,
              "min": 0.0,
              "max": 0.5
            }
          ]
        },
        {
          "group": "Cloud material",
          "params": [
            {
              "var": "g_tint",
              "label": "Body colour",
              "default": [
                0.92,
                0.94,
                1.00
              ]
            },
            {
              "var": "g_tint.w",
              "label": "Opacity",
              "default": 0.85,
              "min": 0.0,
              "max": 1.0
            },
            {
              "var": "g_material.x",
              "label": "Surface detail",
              "default": 0.65,
              "min": 0.0,
              "max": 1.0
            },
            {
              "var": "g_material.y",
              "label": "Edge softness",
              "default": 0.35,
              "min": 0.05,
              "max": 3.0
            },
            {
              "var": "g_material.z",
              "label": "Silver lining",
              "default": 0.90,
              "min": 0.0,
              "max": 2.0
            },
            {
              "var": "g_material.w",
              "label": "Sun halo sharpness",
              "default": 12.0,
              "min": 1.0,
              "max": 48.0
            }
          ]
        }
      ]
    }
  ]
}
